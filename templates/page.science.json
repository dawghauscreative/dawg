          }
        },
        "b2": {
          "type": "card",
          "settings": {
            "number": "",
            "kicker": "",
            "icon": "layers",
            "title": "Skin barrier",
            "text": "<p>The outer skin barrier depends heavily on lipids including ceramides, free fatty acids, and cholesterol.</p><p>Experimental research has shown that nicotinamide can increase synthesis of several of these lipids in keratinocytes.</p>",
            "tag": "Epidermal barrier biology",
            "study": "tanno-nicotinamide-barrier-2000",
            "asset": "science-system-barrier.webp"
          }
        },
