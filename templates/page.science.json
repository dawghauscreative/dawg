      "blocks": {
        "b1": {
          "type": "research_card",
          "settings": {
            "name": "Niacinamide",
            "subtitle": "Vitamin B3",
            "evidence": "Human study + mechanistic research",
            "why": "<p>Nicotinamide takes part in cellular energy metabolism and has been studied in relation to UV-response biology and skin barrier function.</p>",
            "shows_label": "What research shows",
            "shows": "<p>A randomized, double-blind crossover study in healthy volunteers found that oral nicotinamide reduced UV-induced suppression of a measured skin immune response at the doses studied.</p><p>Separate laboratory and topical research found that nicotinamide increased synthesis of ceramides, free fatty acids, and cholesterol involved in epidermal barrier function.</p>",
            "language": "",
            "context": "<p>The barrier-lipid study included cell-culture and topical application research. It is not proof that oral UV Shield+ produces the same effect.</p>",
            "studies": "yiasemides-nicotinamide-2009, tanno-nicotinamide-barrier-2000",
            "anchor": "niacinamide",
            "slide_set": "d02",
            "mixed": false
          }
        },
        "b2": {
          "type": "research_card",
          "settings": {
            "name": "Polypodium leucotomos",
            "subtitle": "Fern-derived botanical extract",
            "evidence": "Human clinical research",
            "why": "<p>Polypodium leucotomos has been studied as an oral botanical in relation to skin responses to ultraviolet exposure.</p>",
            "shows_label": "What research shows",
            "shows": "<p>In a randomized, double-blind, placebo-controlled study of healthy adults, oral Polypodium leucotomos was evaluated for UV-response endpoints over the study period.</p><p>Earlier human research also evaluated oral Polypodium leucotomos in experimentally UV-exposed skin, and newer controlled studies have continued to investigate it in healthy volunteers.</p>",
            "language": "",
            "context": "",
            "studies": "nestor-polypodium-rct, middelkamp-hup-polypodium, faisal-uva-2026",
            "anchor": "polypodium-leucotomos",
            "slide_set": "d01",
            "mixed": false
          }
        },
        "b3": {
          "type": "research_card",
          "settings": {
            "name": "Trans-resveratrol",
            "subtitle": "Polyphenol",
            "evidence": "Human clinical research",
            "why": "<p>Resveratrol is a polyphenol studied for antioxidant, cellular-signaling, and skin-related effects.</p>",
            "shows_label": "What research shows",
            "shows": "<p>A randomized, placebo-controlled study in women aged 40 and older evaluated oral and topical trans-resveratrol over eight weeks and measured several skin parameters, including moisture, elasticity and sebum.</p>",
            "language": "",
            "context": "<p>The dose and study design differ from UV Shield+. It supports ingredient rationale rather than establishing finished-product efficacy.</p>",
            "studies": "rao-resveratrol-2025",
            "anchor": "resveratrol",
            "slide_set": "d04",
            "mixed": false
          }
        },
        "b4": {
          "type": "research_card",
          "settings": {
            "name": "Green tea polyphenols / EGCG",
            "subtitle": "Catechins",
            "evidence": "Human clinical research: mixed",
            "why": "<p>Green tea catechins have antioxidant properties and have been studied in connection with skin exposed to environmental stress.</p>",
            "shows_label": "Research context",
            "shows": "<p>Human research on oral green tea polyphenols has produced mixed results. A two-year randomized placebo-controlled study found some interim changes in selected clinical parameters but did not find oral green tea polyphenols superior to placebo for overall clinical or histologic photoaging outcomes after 24 months.</p>",
            "language": "We include mixed and null findings on purpose.",
            "context": "",
            "studies": "green-tea-two-year-trial",
            "anchor": "egcg",
            "slide_set": "d03",
