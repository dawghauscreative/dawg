        "q1": {
          "type": "item",
          "settings": {
            "question": "What is included in the Complete Skin Defense System?",
            "answer": "One UV Shield+ (60 capsules), one Skinbiotic+ (30 capsules) and one Dermaboost+ (60 capsules)."
          }
        },
        "q2": {
          "type": "item",
          "settings": {
            "question": "Can I start with just one product?",
            "answer": "Yes. Each formula has its own role and you can start with one. The Complete Skin Defense System is the most comprehensive Alchemia MD routine, for people who already understand the individual roles and want all three together."
          }
        },
        "q3": {
          "type": "item",
          "settings": {
            "question": "How do I take the products in this system?",
            "answer": "Take each product as directed on its label. The directions for all three are shown on this page."
          }
        },
        "q4": {
          "type": "item",
          "settings": {
            "question": "How does the system fit with sunscreen?",
            "answer": "UV Shield+ is made to be used alongside your sunscreen, protective clothing and shade. It is not a sunscreen and does not replace sun protection."
          }
        },
        "q5": {
          "type": "item",
          "settings": {
            "question": "Should I check with my healthcare professional first?",
            "answer": "Consult your healthcare professional before taking if you are pregnant, nursing, taking any medications or have a medical condition."
          }
        }
      },
