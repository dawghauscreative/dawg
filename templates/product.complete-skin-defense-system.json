      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "question": "What is Tria Prima?",
            "answer": "<p>Tria Prima combines UV Shield+, Skinbiotic+, and Dermaboost+ into the full Protect + Balance + Restore Alchemia MD routine.†</p>"
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "question": "What products are included?",
            "answer": "<p>UV Shield+, Skinbiotic+, and Dermaboost+.</p>"
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "question": "Do I need every formula?",
            "answer": "<p>No. Each formula can stand on its own, and Alchemia MD also offers targeted two-product bundles. Tria Prima is intended for customers who want support across all three Alchemia MD roles.</p>"
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "question": "What does Protect + Balance + Restore mean?",
            "answer": "<p>Protect: environmental and antioxidant support.† Balance: gut-skin and microbiome support.† Restore: broader nutritional, antioxidant, and normal immune support.†</p>"
          }
        },
        "b5": {
          "type": "item",
          "settings": {
            "question": "Is Tria Prima better than the two-product bundles?",
            "answer": "<p>It is broader, but that does not automatically make it the best fit for every customer.</p>"
          }
        },
        "b6": {
          "type": "item",
          "settings": {
            "question": "Does the bundle replace sunscreen?",
            "answer": "<p>No.</p>"
          }
        },
        "b7": {
          "type": "item",
          "settings": {
            "question": "Does it prevent sunburn?",
            "answer": "<p>No.</p>"
          }
        },
        "b8": {
          "type": "item",
          "settings": {
