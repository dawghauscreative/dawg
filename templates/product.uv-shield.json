      "blocks": {
        "q1": {
          "type": "item",
          "settings": {
            "question": "How does UV Shield+ fit with sunscreen?",
            "answer": "UV Shield+ is made to be used alongside your sunscreen, protective clothing and shade. It is not a sunscreen and does not replace sun protection."
          }
        },
        "q2": {
          "type": "item",
          "settings": {
            "question": "How do I take UV Shield+?",
            "answer": "Take two (2) capsules once daily with water. For enhanced support, take two (2) capsules twice daily with water."
          }
        },
        "q3": {
          "type": "item",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "One bottle lasts 30 days at the daily serving and 15 days at the enhanced serving."
          }
        },
        "q4": {
          "type": "item",
          "settings": {
            "question": "What is in UV Shield+?",
            "answer": "Each serving (2 capsules) contains niacin (as niacinamide), Polypodium leucotomos, EGCG from green tea leaf extract, spirulina and trans-resveratrol. The full Supplement Facts are on this page."
          }
        },
        "q5": {
          "type": "item",
          "settings": {
            "question": "Who is UV Shield+ designed for?",
            "answer": "People who spend time outdoors, such as golfers, tennis players, boaters, beachgoers, travelers and outdoor athletes."
          }
        },
        "q6": {
          "type": "item",
          "settings": {
            "question": "Should I check with my healthcare professional first?",
            "answer": "Consult your healthcare professional before taking if you are pregnant, nursing, taking any medications or have a medical condition."
          }
        }
      },
