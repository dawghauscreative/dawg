{%- comment -%} Support email comes from Theme settings. No phone number, no street address, no support hours. {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="cols cols--2">
      <div>
        {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body, tag: 'h1' -%}
        <p><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></p>
        <p class="small" style="margin-top:.5rem">{{ settings.mailing_address }}</p>
      </div>
      <div>
        {%- form 'contact', id: 'ContactForm' -%}
          <div class="form-grid">
          {%- if form.posted_successfully? -%}
            <p class="form-message">{{ section.settings.success_text }}</p>
          {%- else -%}
            {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="form-grid form-grid--2">
              <div class="field"><label for="Contact-name">Name</label><input id="Contact-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></div>
              <div class="field"><label for="Contact-email">Email</label><input id="Contact-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
            </div>
            <div class="field">
              <label for="Contact-type">Inquiry type</label>
              <select id="Contact-type" name="contact[Inquiry type]">
                {%- assign inquiry_list = section.settings.inquiry_types | split: ',' -%}
                {%- for type in inquiry_list -%}
                  <option value="{{ type | strip | escape }}">{{ type | strip }}</option>
                {%- endfor -%}
              </select>
            </div>
            <div class="field"><label for="Contact-body">Message</label><textarea id="Contact-body" name="contact[body]" required>{{ form.body }}</textarea></div>
            <div><button class="btn" type="submit">{{ section.settings.button_label }}</button></div>
          {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "inquiry_types", "label": "Inquiry types (comma separated)", "default": "Product, Order, Wholesale/Retail, Dermatology Office, Media, Partnership, General" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. We will be in touch." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
