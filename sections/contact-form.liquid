{%- comment -%}
  Contact page. Email, phone and mailing address come from Theme settings > Brand (same values as the Contact policy).
  Returns go to the fulfillment address in the Refund policy, never to the mailing address.
{%- endcomment -%}
{%- assign portal_url = settings.customer_portal_url | default: routes.account_url -%}
<section class="section scheme-{{ section.settings.color_scheme }} contact" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="contact__grid">
      <div class="contact__info">
        {%- render 'section-head', heading: section.settings.heading, body: section.settings.body, tag: 'h1' -%}

        <dl class="contact__details">
          {%- if settings.support_email != blank -%}
            <div><dt>Email</dt><dd><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></dd></div>
          {%- endif -%}
          {%- if settings.support_phone != blank -%}
            <div><dt>Phone</dt><dd><a href="tel:{{ settings.support_phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')' }}">{{ settings.support_phone }}</a></dd></div>
          {%- endif -%}
          {%- if settings.mailing_address != blank and section.settings.show_mailing_address -%}
            <div><dt>Mailing address</dt><dd>{{ settings.mailing_address }}{%- if section.settings.returns_note != blank -%}<span class="contact__note">{{ section.settings.returns_note }}</span>{%- endif -%}</dd></div>
          {%- endif -%}
        </dl>

        <ul class="contact__links">
          <li><a href="/pages/shipping">Shipping</a></li>
          <li><a href="/policies/refund-policy">Returns</a></li>
          <li><a href="{{ portal_url }}">Manage subscription</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>

        {%- if section.settings.image != blank or section.settings.asset != blank -%}
          <div class="contact__media">{% render 'responsive-image', image: section.settings.image, asset: section.settings.asset, asset_width: 1672, asset_height: 928, ratio: '16x9', sizes: '(min-width: 990px) 40vw, 100vw', alt: '' %}</div>
        {%- endif -%}
      </div>

      <div class="contact__form">
        {%- form 'contact', id: 'ContactForm' -%}
          <div class="form-grid">
          {%- if form.posted_successfully? -%}
            <p class="form-message">{{ section.settings.success_text }}</p>
          {%- else -%}
            {%- if form.errors -%}<p class="form-message" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="form-grid form-grid--2">
              <div class="field"><label for="Contact-name">Name</label><input id="Contact-name" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></div>
              <div class="field"><label for="Contact-email">Email</label><input id="Contact-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
            </div>
            <div class="form-grid form-grid--2">
              <div class="field">
                <label for="Contact-type">Topic</label>
                <select id="Contact-type" name="contact[Inquiry type]">
                  {%- assign inquiry_list = section.settings.inquiry_types | split: ',' -%}
                  {%- for type in inquiry_list -%}
                    <option value="{{ type | strip | escape }}">{{ type | strip }}</option>
                  {%- endfor -%}
                </select>
              </div>
              <div class="field"><label for="Contact-order">Order number (optional)</label><input id="Contact-order" type="text" name="contact[Order number]" value="{{ form['Order number'] }}"></div>
            </div>
            <div class="field"><label for="Contact-body">Message</label><textarea id="Contact-body" name="contact[body]" required>{{ form.body }}</textarea></div>
            <div><button class="btn" type="submit">{{ section.settings.button_label }}</button></div>
            {%- if section.settings.reply_note != blank -%}<p class="small contact__note">{{ section.settings.reply_note }}</p>{%- endif -%}
          {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How can we help?" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "checkbox", "id": "show_mailing_address", "label": "Show mailing address", "default": true },
    { "type": "text", "id": "returns_note", "label": "Note under the mailing address", "default": "Not for returns. See our Returns policy for where to send them." },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "asset", "label": "Fallback theme asset filename", "info": "Used only when no image is picked." },
    { "type": "text", "id": "inquiry_types", "label": "Topics (comma separated)", "default": "Product question, Order or shipping, Subscription, Returns, Wholesale or retail, Dermatology office, Media, Partnership, Other" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "reply_note", "label": "Note under the button", "default": "We reply by email." },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. We will be in touch." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
