{%- assign ingredients = product.metafields.custom.ingredients.value -%}
{%- assign citations = product.metafields.custom.tier1_citations -%}
{%- if ingredients.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
    <div class="cols cols--3">
      {%- for ingredient in ingredients -%}
        <article class="ingredient">
          {%- if ingredient.image != blank or section.settings.show_image_frames -%}
            {% render 'responsive-image', image: ingredient.image.value, ratio: '4x5', sizes: '(min-width: 750px) 30vw, 100vw', alt: ingredient.name.value %}
          {%- endif -%}
          {%- if ingredient.role.value != blank -%}<span class="ingredient__role">{{ ingredient.role.value }}</span>{%- endif -%}
          <h3>{{ ingredient.name.value }}</h3>
          {%- if ingredient.amount.value != blank -%}<p class="ingredient__amount">{{ ingredient.amount.value }}</p>{%- endif -%}
          {%- if ingredient.description.value != blank -%}<p>{{ ingredient.description.value }}</p>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- comment -%} Tier 1 public citations only. There is no component for Tier 2 research links. {%- endcomment -%}
    {%- if citations != blank -%}
      <div class="prose small" style="margin-top:48px">
        <h3 style="font-size:1.1rem;margin-bottom:.5rem">{{ section.settings.citations_heading }}</h3>
        {{ citations | metafield_tag }}
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Ingredients are empty and hidden. Fill metafield custom.ingredients.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Ingredient spotlight",
  "settings": [
    { "type": "checkbox", "id": "show_image_frames", "label": "Show an image slot on every ingredient card", "default": true, "info": "Ingredient cards without an image show a placeholder frame. Add the image on the Ingredient entry (Content > Metaobjects)." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ingredients" },
    { "type": "text", "id": "citations_heading", "label": "Citations heading", "default": "Public references" }
  ],
  "presets": [{ "name": "Ingredient spotlight" }]
}
{% endschema %}
