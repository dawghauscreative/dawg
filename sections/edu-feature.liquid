{%- comment -%}
  One oversized editorial feature. Links to the article when its handle exists and is published;
  otherwise the button points at the full article list. Visual: abstract skin biology, never a product bottle.
{%- endcomment -%}
{%- assign ah = section.settings.article | strip -%}
{%- assign fa = '' -%}
{%- if ah != blank -%}{%- assign fkey = section.settings.blog_handle | append: '/' | append: ah -%}{%- assign fa = articles[fkey] -%}{%- endif -%}
<section class="section scheme-{{ section.settings.color_scheme }} edu-feature" {{ section.shopify_attributes }}>
  <div class="container feature-split feature-split--{{ section.settings.image_side }}">
    <div class="feature-split__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.deck != blank -%}<p class="feature-split__sub">{{ section.settings.deck }}</p>{%- endif -%}
      <div class="btn-row">
        {%- if fa != blank -%}
          <a class="btn" href="{{ fa.url }}">{{ section.settings.cta_label }}</a>
        {%- else -%}
          <a class="btn btn--outline" href="#all-articles">Browse all articles</a>
        {%- endif -%}
      </div>
    </div>
    <div class="feature-split__media">
      {%- if fa != blank and fa.image != blank and section.settings.image == blank -%}
        {% render 'responsive-image', image: fa.image, ratio: '4x5', sizes: '(min-width: 990px) 45vw, 100vw', alt: fa.title %}
      {%- else -%}
        {% render 'responsive-image', image: section.settings.image, ratio: '4x5', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.heading %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin Edu feature",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "select", "id": "image_side", "label": "Image side", "default": "right", "options": [{ "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Title" },
    { "type": "textarea", "id": "deck", "label": "Deck" },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "skin-edu" },
    { "type": "text", "id": "article", "label": "Article handle", "info": "The button links to it once the article is published." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read the article" },
    { "type": "image_picker", "id": "image", "label": "Image (abstract skin biology, no product bottles)" }
  ],
  "presets": [{ "name": "Skin Edu feature" }]
}
{% endschema %}
