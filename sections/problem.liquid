{%- assign has_content = false -%}
{%- if section.settings.heading != blank or section.settings.body != blank or section.blocks.size > 0 -%}{%- assign has_content = true -%}{%- endif -%}
{%- if has_content -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    {%- if section.blocks.size > 0 -%}
      <div class="cols cols--{% if section.blocks.size == 6 %}3{% elsif section.blocks.size > 3 %}4{% elsif section.blocks.size == 2 %}2{% else %}3{% endif %}">
        {%- for block in section.blocks -%}
          <div class="benefit{% if block.settings.icon == 'none' and block.settings.title == blank %} benefit--quote{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<span class="icon">{% render 'icon', name: block.settings.icon %}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Problem section is empty and hidden.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Problem",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text", "info": "Empty = hidden. Needs approved copy." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "molecule", "options": [{ "value": "none", "label": "None" }, { "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Problem" }]
}
{% endschema %}
