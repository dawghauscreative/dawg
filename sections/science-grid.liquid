{%- comment -%} Science page. Tier 1 public citations only. No disease claims. No Tier 2 research links. {%- endcomment -%}
{%- if section.settings.heading != blank or section.blocks.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body, tag: 'h1' -%}
    {%- if section.blocks.size > 0 -%}
      <div class="cols cols--3">
        {%- for block in section.blocks -%}
          <article class="card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<span class="icon">{% render 'icon', name: block.settings.icon %}</span>{%- endif -%}
            <h3 style="margin-top:1rem">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.citation_label != blank and block.settings.citation_url != blank -%}
              <p class="small" style="margin-top:1rem"><a href="{{ block.settings.citation_url }}" rel="noopener" target="_blank">{{ block.settings.citation_label }}</a></p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Science grid is empty and hidden.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Science grid",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Science" },
    { "type": "richtext", "id": "body", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "molecule", "options": [{ "value": "none", "label": "None" }, { "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "No disease claims. No 'clinical dose' wording." },
        { "type": "text", "id": "citation_label", "label": "Tier 1 public citation label" },
        { "type": "url", "id": "citation_url", "label": "Tier 1 public citation URL", "info": "Tier 1 only. Tier 2 research links are blocked pending the attorney." }
      ]
    }
  ],
  "presets": [{ "name": "Science grid" }]
}
{% endschema %}
