<article class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <header style="max-width:860px;margin:0 auto 3rem;text-align:center">
      <span class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</span>
      <h1 style="font-size:clamp(2.2rem,4.6vw,4rem)">{{ article.title }}</h1>
    </header>
    {%- if article.image -%}<div style="max-width:1100px;margin:0 auto 3rem">{% render 'responsive-image', image: article.image, ratio: '16x9', sizes: '(min-width: 1100px) 1100px, 100vw', loading: 'eager', alt: article.title %}</div>{%- endif -%}
    <div class="article-body">{{ article.content }}</div>

    {%- if section.settings.product != blank -%}
      <aside class="card" style="max-width:70ch;margin:4rem auto 0;display:grid;gap:1rem">
        <div class="pcard__title">{{ section.settings.product.title }}</div>
        <div><a class="btn" href="{{ section.settings.product.url }}">{{ section.settings.cta_label }}</a></div>
      </aside>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "product", "id": "product", "label": "Product CTA insert", "info": "Shown after the article. No add-to-cart: links to the product page." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop the System" }
  ]
}
{% endschema %}
