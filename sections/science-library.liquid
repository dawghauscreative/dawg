{%- comment -%}
  Searchable, filterable research library. Reads research_study metaobjects (Content > Metaobjects > Research study).
  Only entries ticked "Approved for public display" appear. Tier 1 only; there is no place for Tier 2 links.
{%- endcomment -%}
{%- assign studies = shop.metaobjects.research_study.values -%}
{%- assign shown = 0 -%}
{%- for st in studies -%}{%- if st.public_approved.value == true -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if shown > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} data-library>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="sci-lib__controls">
      <div class="sci-lib__filters" role="group" aria-label="Filter research">
        <button type="button" class="sci-chip is-active" data-filter="all" aria-pressed="true">All</button>
        {%- assign filter_list = section.settings.filters | split: ',' -%}
        {%- for f in filter_list -%}{%- assign f_clean = f | strip -%}<button type="button" class="sci-chip" data-filter="{{ f_clean | escape }}" aria-pressed="false">{{ f_clean }}</button>{%- endfor -%}
      </div>
      <label class="visually-hidden" for="lib-search-{{ section.id }}">Search research</label>
      <input id="lib-search-{{ section.id }}" class="sci-lib__search" type="search" placeholder="Search studies" data-search>
    </div>
    <ul class="sci-lib__list">
      {%- for st in studies -%}
        {%- if st.public_approved.value == true -%}
          {%- assign cats = st.categories.value | join: '|' -%}
          <li class="sci-entry" data-cats="{{ cats | escape }}" data-text="{{ st.title.value | append: ' ' | append: st.authors.value | append: ' ' | append: st.topic.value | downcase | escape }}">
            <div>
              <h3>{{ st.title.value }}</h3>
              <p class="sci-entry__meta">
                {%- if st.authors.value != blank -%}{{ st.authors.value }}{%- endif -%}
                {%- if st.journal.value != blank -%} &middot; {{ st.journal.value }}{%- endif -%}
                {%- if st.year.value != blank -%} &middot; {{ st.year.value }}{%- endif -%}
              </p>
              <p class="sci-entry__tags">{%- if st.study_type.value != blank -%}<span>{{ st.study_type.value }}</span>{%- endif -%}{%- if st.topic.value != blank -%}<span>{{ st.topic.value }}</span>{%- endif -%}</p>
              {%- if st.summary.value != blank -%}<p>{{ st.summary.value }}</p>{%- endif -%}
            </div>
            <a class="text-link" href="{{ st.pubmed_url.value }}" rel="noopener" target="_blank">View study &rarr;</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <p class="sci-lib__empty" data-empty hidden>No studies match your filters.</p>
    {%- if section.settings.note != blank -%}<div class="sci-note prose">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] No approved research studies yet. Tick "Approved for public display" on entries in Content &gt; Metaobjects &gt; Research study.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Research library",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }, { "value": "beige", "label": "Warm beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "filters", "label": "Filters (comma separated)", "default": "Environmental / UV, Skin Barrier, Gut–Skin Axis, Probiotics, Antioxidants, Human Trials, Reviews", "info": "Must match the Filter categories used on each study." },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "presets": [{ "name": "Research library" }]
}
{% endschema %}
