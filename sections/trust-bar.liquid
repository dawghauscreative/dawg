{%- if section.blocks.size > 0 -%}
<section class="scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="trust-strip" style="--cols:{{ section.blocks.size }}">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}<span class="icon">{% render 'icon', name: block.settings.icon %}</span>{%- endif -%}
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.key_ingredients != blank -%}
    <div class="trust-ingredients container">{%- render 'key-ingredients', items: section.settings.key_ingredients -%}</div>
  {%- endif -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Trust strip",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "beige", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }, { "value": "band", "label": "Band (black to green)" }] },
    { "type": "textarea", "id": "key_ingredients", "label": "Key ingredients, phones only (one per line: Label|anchor)", "info": "Optional chips linking to the Science page, shown under the strip on phones only." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "text", "label": "Text", "info": "Verified facts only (label or brand wording)." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Trust strip" }]
}
{% endschema %}
