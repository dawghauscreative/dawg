<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container" style="text-align:center;max-width:720px">
    <span class="eyebrow">404</span>
    <h1>{{ section.settings.heading }}</h1>
    <div class="btn-row" style="justify-content:center"><a class="btn" href="{{ routes.root_url }}">{{ section.settings.button_label }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to home" }
  ]
}
{% endschema %}
