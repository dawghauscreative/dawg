{%- comment -%}
  Active ingredient cards for a product page: slide image, amount (as labeled), role, education copy and a research link.
  Research links go to the Science page only. Amounts are the labeled amounts per serving.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--3 actives">
      {%- for block in section.blocks -%}
        {%- assign slide_set = block.settings.slide_set | strip -%}
        <article class="active-card" {{ block.shopify_attributes }}>
          {%- if slide_set != blank -%}
            {%- assign slide_file = 'slide-' | append: slide_set | append: '-1.webp' -%}
            {% render 'responsive-image', image: block.settings.image, asset: slide_file, ratio: '4x5', sizes: '(min-width: 990px) 30vw, 100vw', alt: block.settings.name %}
          {%- else -%}
            {% render 'responsive-image', image: block.settings.image, ratio: '4x5', sizes: '(min-width: 990px) 30vw, 100vw', alt: block.settings.name %}
          {%- endif -%}
          <div class="active-card__body">
            <span class="active-card__role">{{ block.settings.role }}</span>
            <h3>{{ block.settings.name }}</h3>
            {%- if block.settings.amount != blank -%}<p class="active-card__amount">{{ block.settings.amount }}</p>{%- endif -%}
            {%- if block.settings.badge != blank -%}<p class="active-card__badge">{{ block.settings.badge }}</p>{%- endif -%}
            <div class="active-card__text">{{ block.settings.text }}</div>
            {%- if block.settings.link_label != blank -%}<a class="text-link" href="{{ block.settings.link_url | default: '/pages/science' }}">{{ block.settings.link_label }}</a>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product actives",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }, { "value": "beige", "label": "Warm beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "active",
      "name": "Active ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Ingredient" },
        { "type": "text", "id": "amount", "label": "Amount (as labeled)", "info": "Leave empty when the label shows no separate amount." },
        { "type": "text", "id": "badge", "label": "Evidence label (optional)" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "richtext", "id": "text", "label": "Education copy" },
        { "type": "text", "id": "slide_set", "label": "Ingredient slide set (e.g. d02)" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides the slide)" },
        { "type": "text", "id": "link_label", "label": "Research link label" },
        { "type": "url", "id": "link_url", "label": "Research link (Science page)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Product actives" }]
}
{% endschema %}
