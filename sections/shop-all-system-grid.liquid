{%- comment -%} The other systems. One card per block. Plan routing only. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section--tight scheme-{{ section.settings.color_scheme }} shop-grid-section" {{ section.shopify_attributes }}>
  <div class="container">
    <h2 class="visually-hidden">{{ section.settings.heading }}</h2>
    <div class="shop-grid shop-grid--systems">
      {%- for block in section.blocks -%}
        {%- assign badge = '' -%}
        {%- if block.settings.show_label -%}{%- assign badge = block.settings.label_text -%}{%- endif -%}
        <div class="shop-grid__item" {{ block.shopify_attributes }}>
          {% render 'shop-all-card',
            product: block.settings.product,
            role: block.settings.role,
            descriptor: block.settings.descriptor,
            button_text: block.settings.button_text,
            cue: section.settings.subscribe_cue,
            badge: badge,
            slot: block.settings.compliance_slot,
            size: 'system',
            heading_tag: 'h3' %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop All systems",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Section heading (read by screen readers)", "default": "More systems" },
    { "type": "text", "id": "subscribe_cue", "label": "Subscribe cue (no percentages)", "default": "Subscribe & save available" }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System",
      "settings": [
        { "type": "product", "id": "product", "label": "System" },
        { "type": "text", "id": "role", "label": "Role label" },
        { "type": "textarea", "id": "descriptor", "label": "Descriptor" },
        { "type": "checkbox", "id": "show_label", "label": "Show the extra label", "default": false },
        { "type": "text", "id": "label_text", "label": "Extra label text", "default": "Advanced option" },
        { "type": "textarea", "id": "compliance_slot", "label": "Compliance placeholder — approved wording pending", "info": "Leave empty. Nothing shows until approved wording is entered." },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Choose your plan" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop All systems", "blocks": [{ "type": "system" }, { "type": "system" }, { "type": "system" }] }]
}
{% endschema %}
