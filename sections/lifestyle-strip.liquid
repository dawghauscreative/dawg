{%- if section.blocks.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--{{ section.settings.columns }} lifestyle-grid">
      {%- for block in section.blocks -%}
        {%- comment -%} Tiles without an image show a placeholder frame. {%- endcomment -%}
        {%- if true -%}
          {%- if block.settings.url != blank -%}<a class="lifestyle-tile__link" href="{{ block.settings.url }}">{%- endif -%}
          <figure class="lifestyle-tile{% if block.settings.url != blank %} lifestyle-tile--link{% endif %}" {{ block.shopify_attributes }}>
            {% render 'responsive-image', image: block.settings.image, asset: block.settings.asset, ratio: '4x5', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.label %}
            {%- if block.settings.label != blank or block.settings.caption != blank -%}
              <figcaption class="lifestyle-tile__label">
                {%- if block.settings.label != blank -%}<h3>{{ block.settings.label }}</h3>{%- endif -%}
                {%- if block.settings.caption != blank -%}<p>{{ block.settings.caption }}</p>{%- endif -%}
                {%- if block.settings.url != blank -%}<span class="lifestyle-tile__more">{{ block.settings.link_label | default: 'Read more' }}</span>{%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
          {%- if block.settings.url != blank -%}</a>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.statement != blank -%}<p class="lifestyle-statement">{{ section.settings.statement }}</p>{%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Lifestyle strip has no tiles and is hidden. Use activity shots, not posing.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle strip",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }, { "value": "band", "label": "Band (black to green)" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Tiles per row (desktop)", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "statement", "label": "Bottom statement" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Activity, not posing." },
        { "type": "text", "id": "asset", "label": "Fallback theme asset filename", "info": "Used only when no image is picked." },
        { "type": "text", "id": "label", "label": "Label (shown over the image)" },
        { "type": "text", "id": "caption", "label": "Caption (shown under the label)" },
        { "type": "url", "id": "url", "label": "Link (optional)", "info": "A study, article or page. The tile becomes clickable." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read more" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Lifestyle strip" }]
}
{% endschema %}
