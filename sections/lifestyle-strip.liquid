{%- assign shown = 0 -%}
{%- for block in section.blocks -%}{%- if block.settings.image != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if shown > 0 -%}
<section class="section--tight scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
    <div class="cols cols--4">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <figure style="margin:0" {{ block.shopify_attributes }}>
            {% render 'responsive-image', image: block.settings.image, ratio: '4x5', sizes: '(min-width: 750px) 25vw, 50vw' %}
            {%- if block.settings.caption != blank -%}<figcaption class="small" style="margin-top:10px">{{ block.settings.caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Lifestyle strip has no images and is hidden. Use activity shots, not posing.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle strip",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Activity, not posing. Photo list to be confirmed by Reyshan." },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Lifestyle strip" }]
}
{% endschema %}
