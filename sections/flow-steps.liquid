{%- comment -%}
  Left-to-right flow graphic. Interactive (client review Nov 7): steps light up in turn when scrolled into view; hovering,
  focusing or tapping a step shows its detail in the panel below (assets/theme.js [data-flow]).
{%- endcomment -%}
{%- liquid
  assign has_detail = false
  for block in section.blocks
    if block.settings.detail != blank
      assign has_detail = true
    endif
  endfor
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="flow-wrap{% if has_detail %} flow-wrap--detail{% endif %}" data-flow>
      <ol class="flow">
        {%- for block in section.blocks -%}
          <li class="flow__step" style="--i: {{ forloop.index0 }}" data-step="{{ forloop.index0 }}"{% if has_detail %} tabindex="0" role="button" aria-controls="Flow-{{ section.id }}"{% endif %} {{ block.shopify_attributes }}>
            {%- if block.settings.kicker != blank -%}<span class="flow__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
            <span class="flow__label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ol>
      {%- if has_detail -%}
        <div class="flow__panel" id="Flow-{{ section.id }}" aria-live="polite">
          {%- for block in section.blocks -%}
            <div class="flow__detail" data-step="{{ forloop.index0 }}">
              <span class="flow__detail-num">{{ forloop.index | prepend: '0' }}</span>
              <div><h3>{{ block.settings.label }}</h3><p>{{ block.settings.detail }}</p></div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    {%- if section.settings.takeaway != blank -%}<p class="layers__callout">{{ section.settings.takeaway }}</p>{%- endif -%}
    {%- if section.settings.note != blank -%}<p class="small" style="margin-top:1.5rem;max-width:70ch">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Flow steps",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "green-light", "label": "Lighter green" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "takeaway", "label": "Takeaway" },
    { "type": "text", "id": "note", "label": "Small note" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [{ "type": "text", "id": "kicker", "label": "Small label" }, { "type": "text", "id": "label", "label": "Step" }, { "type": "textarea", "id": "detail", "label": "Detail (shown on hover or tap)" }] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Flow steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
