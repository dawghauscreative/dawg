{%- comment -%} Intro plus the individual formulas. One card per block, each with a small "Also in" line. Plan routing only. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }} shop-grid-section" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body, tag: 'h2' -%}
    <div class="shop-grid shop-grid--singles">
      {%- for block in section.blocks -%}
        <div class="shop-grid__item" {{ block.shopify_attributes }}>
          {% render 'shop-all-card',
            product: block.settings.product,
            role: block.settings.role,
            descriptor: block.settings.descriptor,
            button_text: block.settings.button_text,
            cue: section.settings.subscribe_cue,
            rel_1: block.settings.related_1,
            rel_2: block.settings.related_2,
            rel_3: block.settings.related_3,
            size: 'single',
            heading_tag: 'h3' %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Shop All formulas",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Individual formulas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with one role" },
    { "type": "textarea", "id": "body", "label": "Supporting text", "default": "Choose the formula that matches your current priority, then explore the systems that pair it with complementary support." },
    { "type": "text", "id": "subscribe_cue", "label": "Subscribe cue (no percentages)", "default": "Subscribe & save available" }
  ],
  "blocks": [
    {
      "type": "formula",
      "name": "Formula",
      "settings": [
        { "type": "product", "id": "product", "label": "Formula" },
        { "type": "text", "id": "role", "label": "Role label" },
        { "type": "textarea", "id": "descriptor", "label": "Descriptor" },
        { "type": "product", "id": "related_1", "label": "Also in: system 1" },
        { "type": "product", "id": "related_2", "label": "Also in: system 2" },
        { "type": "product", "id": "related_3", "label": "Also in: system 3" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Choose your plan" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Shop All formulas", "blocks": [{ "type": "formula" }, { "type": "formula" }, { "type": "formula" }] }]
}
{% endschema %}
