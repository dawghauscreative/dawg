<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container sci-sun">
    <span class="sci-sun__icon icon" aria-hidden="true">{% render 'icon', name: 'shield' %}</span>
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <div class="prose lede">{{ section.settings.body }}</div>
      {%- assign items = section.settings.items | newline_to_br | split: '<br />' -%}
      <ul class="sci-checks">{%- for item in items -%}{%- assign item_text = item | strip -%}{%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- if section.settings.callout != blank -%}<p class="sci-callout">{{ section.settings.callout }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sunscreen statement",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "textarea", "id": "items", "label": "Checklist (one per line)" },
    { "type": "text", "id": "callout", "label": "Callout" }
  ],
  "presets": [{ "name": "Sunscreen statement" }]
}
{% endschema %}
