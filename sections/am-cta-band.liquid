{% comment %} ============================================================
  SECTION: am-cta-band.liquid
  Full-width CTA band. Used across multiple page templates.
  Supports dark/gold/green background, optional tagline,
  and both inline (split) and stacked layouts.
============================================================ {% endcomment %}

<section class="section cta-band {{ section.settings.bg_style }}" {{ section.shopify_attributes }}>
  <div class="container cta-band__inner">

    <div class="am-fade">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div style="display:flex;flex-direction:column;align-items:flex-start;gap:1.2rem">
      <a class="button {{ section.settings.cta_style | default: 'button--gold' }} am-fade"
         href="{{ section.settings.cta_url | default: section.settings.cta_link | default: '/pages/system' }}"
         style="animation-delay:80ms">
        {{ section.settings.cta_label | default: 'Shop the system bundle' }}
      </a>

      {%- if section.settings.tagline != blank -%}
        <p style="margin:0;font-size:0.75rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;opacity:0.72">
          {{ section.settings.tagline }}
        </p>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "CTA Band",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background",
      "options": [
        { "value": "",              "label": "Default (green-dark)" },
        { "value": "section--dark", "label": "Dark" },
        { "value": "section--charcoal", "label": "Charcoal" },
        { "value": "section--cream", "label": "Cream" },
        { "value": "section--green", "label": "Deep green" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "button--gold",    "label": "Gold" },
        { "value": "button--light",   "label": "Light" },
        { "value": "button--outline", "label": "Outline" },
        { "value": "button--dark",    "label": "Dark" }
      ],
      "default": "button--gold"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Begin the routine"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the complete skin defense system."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Three dermatologist-formulated supplements designed to support skin protection, balance, and restoration from within."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the system bundle"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline below button (optional)",
      "info": "Example: PROTECT  •  BALANCE  •  RESTORE"
    }
  ],
  "presets": [
    {
      "name": "CTA Band",
      "settings": {
        "eyebrow": "Begin the routine",
        "heading": "Start with the complete skin defense system.",
        "body": "Three dermatologist-formulated supplements designed to support skin protection, balance, and restoration from within.",
        "cta_label": "Shop the system bundle"
      }
    }
  ]
}
{% endschema %}
