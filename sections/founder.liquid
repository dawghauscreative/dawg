<section class="founder-split{% if section.settings.image_side == 'left' %} founder-split--img-left{% endif %} scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="founder-split__copy">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.credentials != blank -%}<p class="small" style="margin-top:12px;letter-spacing:.14em;text-transform:uppercase">{{ section.settings.credentials }}</p>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="prose" style="margin-top:1.5rem">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <div class="btn-row"><a class="btn btn--outline" href="{{ section.settings.link_url | default: '/pages/founder' }}">{{ section.settings.link_label }}</a></div>
    {%- endif -%}
  </div>
  <div class="founder-split__media">
    {% render 'responsive-image', image: section.settings.image, asset: section.settings.image_asset, asset_width: 1122, asset_height: 1402, sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image_alt %}
  </div>
</section>

{% schema %}
{
  "name": "Founder",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }, { "value": "band", "label": "Band (black to green)" }] },
    { "type": "image_picker", "id": "image", "label": "Portrait", "info": "Dr. Mia Luna." },
    { "type": "text", "id": "image_asset", "label": "Fallback theme asset filename", "info": "Used only when no portrait is picked above." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Dr. Mia Luna" },
    { "type": "select", "id": "image_side", "label": "Image side", "default": "right", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dr. Mia Luna" },
    { "type": "text", "id": "credentials", "label": "Credentials line", "info": "Only verified credentials." },
    { "type": "richtext", "id": "body", "label": "Story", "info": "Empty until approved copy is supplied." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "Founder" }]
}
{% endschema %}
