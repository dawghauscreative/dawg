<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="cols cols--2" style="align-items:center">
      <div{% if section.settings.image_side == 'right' %} style="order:2"{% endif %}>
        {% render 'responsive-image', image: section.settings.image, ratio: '4x5', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.image_alt %}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.credentials != blank -%}<p class="small" style="margin-top:12px;letter-spacing:.14em;text-transform:uppercase">{{ section.settings.credentials }}</p>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="prose" style="margin-top:1.5rem">{{ section.settings.body }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <div class="btn-row"><a class="btn btn--outline" href="{{ section.settings.link_url | default: '/pages/founder' }}">{{ section.settings.link_label }}</a></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "image_picker", "id": "image", "label": "Portrait", "info": "Dr. Mia Luna. Final photo to be confirmed by Reyshan." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Dr. Mia Luna" },
    { "type": "select", "id": "image_side", "label": "Image side", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dr. Mia Luna" },
    { "type": "text", "id": "credentials", "label": "Credentials line", "info": "Only verified credentials." },
    { "type": "richtext", "id": "body", "label": "Story", "info": "Empty until approved copy is supplied." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "Founder" }]
}
{% endschema %}
