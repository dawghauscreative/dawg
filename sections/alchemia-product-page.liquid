{% liquid
  assign hero_image = section.settings.hero_image
  assign fallback_asset = section.settings.fallback_asset | default: 'uv-shield-hero.jpg'
  assign fallback_src = fallback_asset | asset_url
  if fallback_asset contains '://'
    assign fallback_src = fallback_asset
  endif

  assign founder_image = section.settings.founder_image
  assign founder_image_asset = section.settings.founder_image_asset | default: 'mia-founder-editorial.jpg'
  assign founder_image_src = founder_image_asset | asset_url
  if founder_image_asset contains '://'
    assign founder_image_src = founder_image_asset
  endif

  assign display_title = section.settings.product_name
  if display_title == blank and product != blank
    assign display_title = product.title
  endif

  assign selected_variant = product.selected_or_first_available_variant
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign use_case_blocks = section.blocks | where: 'type', 'use_case'
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign how_to_use_blocks = section.blocks | where: 'type', 'how_to_use_step'

  if product != blank
    assign product_form_id = 'product-form-' | append: section.id
  endif

  assign final_atc_label_rendered = section.settings.final_atc_label | replace: '{title}', display_title
%}

{%- style -%}
  #shopify-section-{{ section.id }} .product-hero__buy h1 {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .product-hero__buy .eyebrow {
    color: {{ section.settings.eyebrow_color }};
  }
  #shopify-section-{{ section.id }} .product-hero__buy p {
    color: {{ section.settings.body_color }};
  }
  #shopify-section-{{ section.id }} .product-hero__buy .role-badge {
    color: {{ section.settings.badge_color }};
  }
  #shopify-section-{{ section.id }} .product-hero__buy .trust-line span {
    color: {{ section.settings.trust_color }};
  }
  #shopify-section-{{ section.id }} .section--dark h2,
  #shopify-section-{{ section.id }} .section--dark p,
  #shopify-section-{{ section.id }} .section--dark li,
  #shopify-section-{{ section.id }} .section--dark .eyebrow {
    color: {{ section.settings.dark_section_text_color }};
  }
  #shopify-section-{{ section.id }} .section--charcoal h2,
  #shopify-section-{{ section.id }} .section--charcoal p,
  #shopify-section-{{ section.id }} .section--charcoal .eyebrow {
    color: {{ section.settings.charcoal_section_text_color }};
  }
{%- endstyle -%}

<section class="product-hero">
  <div class="product-hero__media">
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 1100 | image_tag: widths: '520, 760, 1100', loading: 'eager', alt: display_title }}
    {% elsif product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 1100 | image_tag: widths: '520, 760, 1100', loading: 'eager', alt: product.title }}
    {% else %}
      <img src="{{ fallback_src }}" alt="{{ display_title | escape }}" loading="eager">
    {% endif %}
  </div>

  <div class="product-hero__buy">
    <div class="purchase-card">
      <div class="breadcrumbs">
        <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home }}</a> /
        <a href="{{ section.settings.breadcrumb_shop_url }}">{{ section.settings.breadcrumb_shop }}</a> /
        {{ display_title }}
      </div>

      <span class="role-badge">{{ section.settings.role_badge_prefix }}{{ section.settings.role }}</span>

      <h1>{{ display_title }}</h1>

      <p class="eyebrow">{{ section.settings.positioning_line }}</p>

      <p>{{ section.settings.short_description }}</p>

      <div class="trust-line">
        {% if trust_blocks.size > 0 %}
          {% for block in trust_blocks %}
            <span {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {% endfor %}
        {% else %}
          <span>{{ section.settings.trust_1 }}</span>
          <span>{{ section.settings.trust_2 }}</span>
          <span>{{ section.settings.trust_3 }}</span>
        {% endif %}
      </div>

      <div id="atc-sentinel"></div>

      {% if product != blank %}
        {% form 'product', product, id: product_form_id, class: 'buy-buttons' %}

          {% if product.has_only_default_variant == false %}
            <select
              class="variant-select"
              name="id"
              data-variant-select
              aria-label="Choose {{ product.title | escape }}"
            >
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price | money }}"
                  data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                  data-available="{{ variant.available }}"
                  {% if variant == selected_variant %}selected="selected"{% endif %}
                >
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {% endif %}

          <div class="product-price">
            <span data-selected-price>{{ selected_variant.price | money }}</span>

            <s data-compare-price {% unless selected_variant.compare_at_price > selected_variant.price %}hidden{% endunless %}>
              {{ selected_variant.compare_at_price | money }}
            </s>
          </div>

          <div class="quantity-row">
            <input
              class="quantity-input"
              type="number"
              name="quantity"
              value="1"
              min="1"
              aria-label="{{ 'products.product.quantity' | t }}"
            >

            <button
              class="button button--gold"
              type="submit"
              name="add"
              data-add-to-cart
              {% unless selected_variant.available %}disabled{% endunless %}
            >
              {% if selected_variant.available %}
                {{ section.settings.atc_label }}
              {% else %}
                {{ section.settings.sold_out_label }}
              {% endif %}
            </button>
          </div>

        {% endform %}

        <div id="sticky-atc" class="sticky-atc" aria-hidden="true">
          <span class="sticky-atc__title">{{ display_title }}</span>

          <button
            class="button button--gold"
            type="button"
            data-sticky-atc-btn
            {% unless selected_variant.available %}disabled{% endunless %}
          >
            {% if selected_variant.available %}
              {{ section.settings.atc_label }}
            {% else %}
              {{ section.settings.sold_out_label }}
            {% endif %}
          </button>
        </div>
      {% else %}
        <a class="button button--gold" href="{{ section.settings.fallback_atc_url }}">{{ section.settings.atc_label }}</a>
      {% endif %}

      <a class="button button--outline" href="{{ section.settings.system_url }}">{{ section.settings.system_button_label }}</a>

      {% for block in section.blocks %}
        {% if block.type == '@app' %}
          {% render block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if benefit_blocks.size > 0 %}
  <section class="product-benefits" aria-label="{{ display_title }} benefits">
    {% for block in benefit_blocks %}
      <article class="product-benefit" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </article>
    {% endfor %}
  </section>
{% endif %}

<section class="section section--cream">
  <div class="container product-detail">
    <nav class="detail-nav" aria-label="Product detail sections">
      <a href="#description">{{ section.settings.nav_description }}</a>
      <a href="#who">{{ section.settings.nav_who }}</a>
      <a href="#ingredients">{{ section.settings.nav_ingredients }}</a>
      <a href="#use">{{ section.settings.nav_use }}</a>
      <a href="#faq">{{ section.settings.nav_faq }}</a>
    </nav>

    <div id="description">
      <span class="role-badge">{{ section.settings.role }}</span>

      <h2>{{ section.settings.role_heading }}</h2>

      <p>{{ section.settings.role_body }}</p>

      <div id="who" class="section-header section-header--left">
        <h2>{{ section.settings.why_heading }}</h2>
        <p>{{ section.settings.why_intro }}</p>
      </div>

      {% if use_case_blocks.size > 0 %}
        <div class="grid grid--2">
          {% for block in use_case_blocks %}
            <article class="card" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <aside id="ingredients" class="ingredient-card">
      <h3>{{ section.settings.formula_heading }}</h3>

      <p>{{ section.settings.formula_body }}</p>

      {% if ingredient_blocks.size > 0 %}
        <div class="ingredient-list">
          {% for block in ingredient_blocks %}
            <div class="ingredient-item" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              <p>{{ block.settings.text }}</p>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </aside>
  </div>
</section>

<section class="section section--dark" id="use">
  <div class="container split">
    <div>
      <span class="eyebrow">{{ section.settings.how_eyebrow }}</span>

      <h2>{{ section.settings.how_heading }}</h2>

      <p>{{ section.settings.how_intro }}</p>

      <ul class="feature-list">
        {% if how_to_use_blocks.size > 0 %}
          {% for block in how_to_use_blocks %}
            <li {{ block.shopify_attributes }}>{{ block.settings.step }}</li>
          {% endfor %}
        {% else %}
          <li>{{ section.settings.how_step_1 }}</li>
          <li>{{ section.settings.how_step_2 }}</li>
          <li>{{ section.settings.how_step_3 }}</li>
          {% if section.settings.role == 'Protect' %}
            <li>{{ section.settings.how_step_protect }}</li>
          {% endif %}
        {% endif %}
      </ul>
    </div>

    <div class="bundle-upsell">
      <div>
        <span class="eyebrow">{{ section.settings.upsell_eyebrow }}</span>

        <h3>{{ section.settings.upsell_heading }}</h3>

        <p>{{ section.settings.upsell_text }}</p>
      </div>

      <a class="button button--gold" href="{{ section.settings.upsell_url }}">{{ section.settings.upsell_button_label }}</a>
    </div>
  </div>
</section>

<section class="section section--charcoal">
  <div class="container split">
    <div class="media-frame media-frame--portrait">
      {% if founder_image != blank %}
        {{ founder_image | image_url: width: 800 | image_tag: widths: '400, 600, 800', loading: 'lazy', alt: section.settings.founder_image_alt }}
      {% else %}
        <img src="{{ founder_image_src }}" alt="{{ section.settings.founder_image_alt | escape }}" loading="lazy">
      {% endif %}
    </div>

    <div>
      <span class="eyebrow">{{ section.settings.founder_eyebrow }}</span>

      <h2>{{ section.settings.founder_heading }}</h2>

      <p>{{ section.settings.founder_text }}</p>

      <a class="button button--outline" href="{{ section.settings.founder_button_url }}">{{ section.settings.founder_button_label }}</a>
    </div>
  </div>
</section>

{% if faq_blocks.size > 0 %}
  <section class="section section--cream" id="faq">
    <div class="container grid grid--2">
      <div>
        <span class="eyebrow">{{ section.settings.faq_eyebrow }}</span>

        <h2>{{ display_title }} {{ section.settings.faq_heading_suffix }}</h2>
      </div>

      <div class="faq-list">
        {% for block in faq_blocks %}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

<section class="section cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{{ section.settings.final_heading }}</h2>
      <p>{{ section.settings.final_text }}</p>
    </div>

    {% if product != blank %}
      <button
        class="button button--gold"
        type="button"
        data-final-atc-btn
        {% unless selected_variant.available %}disabled{% endunless %}
      >
        {% if selected_variant.available %}
          {{ section.settings.final_atc_label | replace: '{title}', display_title }}
        {% else %}
          {{ section.settings.sold_out_label }}
        {% endif %}
      </button>
    {% else %}
      <a class="button button--gold" href="{{ section.settings.fallback_atc_url }}">{{ section.settings.final_atc_label | replace: '{title}', display_title }}</a>
    {% endif %}
  </div>
</section>

{% if product != blank %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var productForm = document.getElementById('{{ product_form_id }}');
    var variantSelect = document.querySelector('[data-variant-select]');
    var priceEl = document.querySelector('[data-selected-price]');
    var comparePriceEl = document.querySelector('[data-compare-price]');
    var mainAtcButton = document.querySelector('[data-add-to-cart]');
    var stickyAtcButton = document.querySelector('[data-sticky-atc-btn]');
    var finalAtcButton = document.querySelector('[data-final-atc-btn]');
    var stickyAtc = document.getElementById('sticky-atc');
    var sentinel = document.getElementById('atc-sentinel');

    function submitProductForm() {
      if (!productForm) return;
      if (typeof productForm.requestSubmit === 'function') {
        productForm.requestSubmit();
      } else {
        productForm.submit();
      }
    }

    function updateButtonState(isAvailable) {
      var atcLabel = '{{ section.settings.atc_label | escape }}';
      var soldOut = '{{ section.settings.sold_out_label | escape }}';
      var finalLabel = '{{ final_atc_label_rendered | escape }}';

      if (mainAtcButton) {
        mainAtcButton.disabled = !isAvailable;
        mainAtcButton.textContent = isAvailable ? atcLabel : soldOut;
      }
      if (stickyAtcButton) {
        stickyAtcButton.disabled = !isAvailable;
        stickyAtcButton.textContent = isAvailable ? atcLabel : soldOut;
      }
      if (finalAtcButton) {
        finalAtcButton.disabled = !isAvailable;
        finalAtcButton.textContent = isAvailable ? finalLabel : soldOut;
      }
    }

    if (variantSelect) {
      variantSelect.addEventListener('change', function () {
        var selectedOption = variantSelect.options[variantSelect.selectedIndex];
        var isAvailable = selectedOption.getAttribute('data-available') === 'true';
        var price = selectedOption.getAttribute('data-price');
        var comparePrice = selectedOption.getAttribute('data-compare-price');

        if (priceEl && price) priceEl.textContent = price;

        if (comparePriceEl) {
          if (comparePrice) {
            comparePriceEl.textContent = comparePrice;
            comparePriceEl.hidden = false;
          } else {
            comparePriceEl.hidden = true;
          }
        }

        updateButtonState(isAvailable);
      });
    }

    if (stickyAtcButton) {
      stickyAtcButton.addEventListener('click', function () { submitProductForm(); });
    }

    if (finalAtcButton) {
      finalAtcButton.addEventListener('click', function () { submitProductForm(); });
    }

    if (stickyAtc && sentinel && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            stickyAtc.setAttribute('aria-hidden', 'true');
            stickyAtc.classList.remove('is-visible');
          } else {
            stickyAtc.setAttribute('aria-hidden', 'false');
            stickyAtc.classList.add('is-visible');
          }
        });
      });
      observer.observe(sentinel);
    }
  });
</script>
{% endif %}

{% schema %}
{
  "name": "Alchemia product page",
  "settings": [
    {
      "type": "header",
      "content": "Product basics"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product name",
      "default": "UV Shield+"
    },
    {
      "type": "text",
