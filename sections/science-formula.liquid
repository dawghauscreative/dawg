{%- comment -%}
  One formula's science: header, ingredient chips, slide image, optional feature callout, and research cards.
  Citations come from research_study metaobjects by handle and only appear when approved for public display.
  Ingredient research is not finished-product testing. Nothing is written here.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }} sci-formula" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="sci-formula__head">
      <div>
        {%- if section.settings.role != blank -%}<span class="eyebrow">{{ section.settings.role }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subhead != blank -%}<p class="sci-formula__sub">{{ section.settings.subhead }}</p>{%- endif -%}
        <div class="prose sci-formula__intro">{{ section.settings.intro }}</div>
        {%- if section.settings.ingredients != blank -%}
          {%- assign chips = section.settings.ingredients | newline_to_br | split: '<br />' -%}
          <ul class="sci-chips">{%- for chip in chips -%}{%- assign chip_text = chip | strip -%}{%- if chip_text != blank -%}<li>{{ chip_text }}</li>{%- endif -%}{%- endfor -%}</ul>
        {%- endif -%}
        {%- if section.settings.product != blank -%}<p><a class="text-link" href="{{ section.settings.product.url }}">View {{ section.settings.product.title }}</a></p>{%- endif -%}
      </div>
      <figure class="sci-formula__slide">
        {% render 'responsive-image', image: section.settings.image, ratio: '4x5', sizes: '(min-width: 990px) 34vw, 100vw', alt: section.settings.image_alt %}
        {%- if section.settings.image_caption != blank -%}<figcaption class="small">{{ section.settings.image_caption }}</figcaption>{%- endif -%}
      </figure>
    </div>

    {%- if section.settings.feature_title != blank -%}
      <div class="sci-feature">
        {%- if section.settings.feature_image != blank or section.settings.feature_show_frame -%}
          <div class="sci-feature__media">{% render 'responsive-image', image: section.settings.feature_image, ratio: '4x5', sizes: '(min-width: 990px) 28vw, 100vw', alt: section.settings.feature_title %}</div>
        {%- endif -%}
        <div>
          <h3>{{ section.settings.feature_title }}</h3>
          <div class="prose">{{ section.settings.feature_body }}</div>
          {%- if section.settings.feature_studies != blank -%}
            <ul class="sci-links">
              {%- assign f_handles = section.settings.feature_studies | split: ',' -%}
              {%- for h in f_handles -%}{%- assign h_clean = h | strip -%}<li>{% render 'study-link', handle: h_clean %}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="cols cols--2 sci-research">
      {%- for block in section.blocks -%}
        <article class="sci-rcard{% if block.settings.mixed %} sci-rcard--mixed{% endif %}" {{ block.shopify_attributes }}>
          <header>
            <div>
              <h3>{{ block.settings.name }}</h3>
              {%- if block.settings.subtitle != blank -%}<p class="sci-rcard__sub">{{ block.settings.subtitle }}</p>{%- endif -%}
            </div>
            {%- if block.settings.evidence != blank -%}<span class="sci-badge">{{ block.settings.evidence }}</span>{%- endif -%}
          </header>
          {%- if block.settings.why != blank -%}<div class="sci-rcard__row"><h4>Why it is here</h4><div>{{ block.settings.why }}</div></div>{%- endif -%}
          {%- if block.settings.shows != blank -%}<div class="sci-rcard__row"><h4>{{ block.settings.shows_label | default: 'What research shows' }}</h4><div>{{ block.settings.shows }}</div></div>{%- endif -%}
          {%- if block.settings.language != blank -%}<p class="sci-rcard__quote">{{ block.settings.language }}</p>{%- endif -%}
          {%- if block.settings.context != blank -%}<div class="sci-rcard__row sci-rcard__row--context"><h4>Important context</h4><div>{{ block.settings.context }}</div></div>{%- endif -%}
          {%- if block.settings.studies != blank -%}
            <ul class="sci-links">
              {%- assign s_handles = block.settings.studies | split: ',' -%}
              {%- for h in s_handles -%}{%- assign h_clean = h | strip -%}<li>{% render 'study-link', handle: h_clean %}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<div class="sci-note prose">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science formula",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }, { "value": "beige", "label": "Warm beige" }] },
    { "type": "text", "id": "role", "label": "Role (Protect, Balance, Restore)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subhead", "label": "Subheadline" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "textarea", "id": "ingredients", "label": "Ingredient chips (one per line)" },
    { "type": "product", "id": "product", "label": "Product link" },
    { "type": "header", "content": "Slide image" },
    { "type": "image_picker", "id": "image", "label": "Slide image", "info": "Ingredient slide. Shows a placeholder frame when empty." },
    { "type": "text", "id": "image_alt", "label": "Slide alt text" },
    { "type": "text", "id": "image_caption", "label": "Slide caption" },
    { "type": "header", "content": "Feature callout (optional)" },
    { "type": "text", "id": "feature_title", "label": "Title" },
    { "type": "richtext", "id": "feature_body", "label": "Text" },
    { "type": "text", "id": "feature_studies", "label": "Citations (study handles, comma separated)" },
    { "type": "image_picker", "id": "feature_image", "label": "Image" },
    { "type": "checkbox", "id": "feature_show_frame", "label": "Show image frame when empty", "default": true },
    { "type": "header", "content": "Footer" },
    { "type": "richtext", "id": "note", "label": "Note" }
  ],
  "blocks": [
    {
      "type": "research_card",
      "name": "Research card",
      "settings": [
        { "type": "text", "id": "name", "label": "Ingredient" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "text", "id": "evidence", "label": "Evidence level badge" },
        { "type": "richtext", "id": "why", "label": "Why it is here" },
        { "type": "text", "id": "shows_label", "label": "Research label", "default": "What research shows" },
        { "type": "richtext", "id": "shows", "label": "Research text" },
        { "type": "text", "id": "language", "label": "Public language line" },
        { "type": "richtext", "id": "context", "label": "Important context" },
        { "type": "text", "id": "studies", "label": "Citations (study handles, comma separated)" },
        { "type": "checkbox", "id": "mixed", "label": "Mixed or null findings", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Science formula" }]
}
{% endschema %}
