<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', heading: section.settings.heading, eyebrow: section.settings.eyebrow -%}
    <div class="layers">
      <div class="layers__stack" aria-hidden="true">
        {%- for block in section.blocks -%}
          <div class="layers__bar" style="--i: {{ forloop.index0 }}"><span>{{ forloop.index | prepend: '0' }}</span>{{ block.settings.short }}</div>
        {%- endfor -%}
      </div>
      <ol class="layers__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="layers__num">{{ forloop.index | prepend: '0' }}</span>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.callout != blank -%}<p class="layers__callout">{{ section.settings.callout }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Layer stack",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "callout", "label": "Callout" }
  ],
  "blocks": [
    { "type": "layer", "name": "Layer", "settings": [{ "type": "text", "id": "short", "label": "Short label (diagram)" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" }] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Layer stack", "blocks": [{ "type": "layer" }, { "type": "layer" }, { "type": "layer" }, { "type": "layer" }] }]
}
{% endschema %}
