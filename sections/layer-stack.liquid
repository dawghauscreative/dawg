{%- comment -%} Layers graphic: step numbers removed (Nov 12) so each layer shows only its name. {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', heading: section.settings.heading, eyebrow: section.settings.eyebrow, body: section.settings.body -%}
    {%- comment -%} Interactive (client review Nov 7): hovering, focusing or tapping a layer highlights it and its explanation; bars slide in on scroll (assets/theme.js [data-layers]). {%- endcomment -%}
    <div class="layers" data-layers data-scroll-steps="single">
      <div class="layers__stack">
        {%- for block in section.blocks -%}
          <button class="layers__bar" type="button" style="--i: {{ forloop.index0 }}" data-layer="{{ forloop.index0 }}" aria-describedby="Layer-{{ section.id }}-{{ forloop.index0 }}">{{ block.settings.short }}</button>
        {%- endfor -%}
      </div>
      <ol class="layers__list">
        {%- for block in section.blocks -%}
          <li id="Layer-{{ section.id }}-{{ forloop.index0 }}" data-layer="{{ forloop.index0 }}" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    {%- if section.settings.callout != blank -%}<p class="layers__callout">{{ section.settings.callout }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Layer stack",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Light" }, { "value": "grey", "label": "Grey (brand)" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Intro text" },
    { "type": "text", "id": "callout", "label": "Callout" }
  ],
  "blocks": [
    { "type": "layer", "name": "Layer", "settings": [{ "type": "text", "id": "short", "label": "Short label (diagram)" }, { "type": "text", "id": "title", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" }] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Layer stack", "blocks": [{ "type": "layer" }, { "type": "layer" }, { "type": "layer" }, { "type": "layer" }] }]
}
{% endschema %}
