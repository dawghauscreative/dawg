<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-head"><h1>{{ section.settings.heading }}</h1></div>
    <div class="cols cols--3">
      {%- for collection in collections -%}
        <a class="pcard" href="{{ collection.url }}">
          <div class="pcard__media">{% render 'responsive-image', image: collection.featured_image, ratio: '4x5', sizes: '(min-width: 750px) 33vw, 100vw', alt: collection.title %}</div>
          <div class="pcard__body"><h2 class="pcard__title">{{ collection.title }}</h2></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
