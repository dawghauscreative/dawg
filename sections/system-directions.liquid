{%- comment -%}
  Label directions for each included product, read word for word from custom.directions on that product (falls back to custom.how_it_works).
  Nothing is combined or rewritten here. A product with empty directions is hidden.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="directions-grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- capture dir_text -%}{%- render 'product-directions', p: p -%}{%- endcapture -%}
          {%- assign dir_text = dir_text | strip -%}
          {%- if dir_text != blank -%}
            <article {{ block.shopify_attributes }}>
              <h3>{{ p.title }}</h3>
              <p>{{ dir_text | escape | newline_to_br }}</p>
            </article>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="small" style="margin-top:2rem">{{ section.settings.note }}</p>{%- endif -%}
    {%- if section.settings.show_slot -%}{%- render 'compliance-slot', content: product.metafields.custom.compliance_slot -%}{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "System directions",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note under the directions" },
    { "type": "checkbox", "id": "show_slot", "label": "Show the product compliance slot here", "default": false, "info": "Empty and hidden until content is added to the product's compliance slot." }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "System directions" }]
}
{% endschema %}
