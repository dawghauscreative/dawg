{%- comment -%}
  Label directions for each included product, read word for word from custom.how_it_works on that product.
  Nothing is combined or rewritten here. A product with empty directions is hidden.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="directions-grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank and p.metafields.custom.how_it_works != blank -%}
          <article {{ block.shopify_attributes }}>
            <h3>{{ p.title }}</h3>
            <p>{{ p.metafields.custom.how_it_works.value | newline_to_br }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="small" style="margin-top:2rem">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "System directions",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "note", "label": "Note under the directions" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "System directions" }]
}
{% endschema %}
