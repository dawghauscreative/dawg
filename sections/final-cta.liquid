{%- assign p = section.settings.product -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container" style="text-align:center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 style="max-width:18ch;margin-inline:auto">{{ section.settings.heading | default: p.title }}</h2>
    {%- if section.settings.body != blank -%}<div class="lede" style="margin:1.5rem auto 0">{{ section.settings.body }}</div>{%- endif -%}
    <div class="btn-row" style="justify-content:center">
      <a class="btn" href="{{ p.url | default: routes.collections_url }}">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "product", "id": "product", "label": "Bundle", "info": "Hero bundle is Sun Safe System." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Blank = product title." },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the System" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
