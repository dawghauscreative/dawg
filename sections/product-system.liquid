<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols {% if section.settings.columns == '4' %}cols--auto4{% else %}cols--3{% endif %}">
      {%- for block in section.blocks -%}
        <div class="{% if block.settings.featured %}pcard-wrap--featured{% endif %}" {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product, role: block.settings.role %}</div>
      {%- endfor -%}
    </div>
    {%- assign bundle = section.settings.bundle_product -%}
    {%- if bundle != blank -%}
      {%- assign parts = bundle.metafields.custom.bundle_components.value -%}
      <div class="bundle-panel">
        <div>
          {%- if section.settings.bundle_eyebrow != blank -%}<span class="eyebrow" style="margin-bottom:.6rem">{{ section.settings.bundle_eyebrow }}</span>{%- endif -%}
          <h3>{{ bundle.title }}</h3>
          {%- if parts.size > 0 -%}<p>{% for c in parts %}{{ c.title }}{% unless forloop.last %} + {% endunless %}{% endfor %}</p>{%- elsif bundle.metafields.custom.tagline != blank -%}<p>{{ bundle.metafields.custom.tagline }}</p>{%- endif -%}
        </div>
        <a class="btn" href="{{ bundle.url }}">{{ section.settings.bundle_button_label }}</a>
      </div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:56px">
        <a class="btn btn--outline" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product system",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [{ "value": "3", "label": "3 per row" }, { "value": "4", "label": "4 per row" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "header", "content": "Bundle panel (optional)" },
    { "type": "product", "id": "bundle_product", "label": "Bundle", "info": "Hero bundle is Sun Safe System. Title and components are read from product data." },
    { "type": "text", "id": "bundle_eyebrow", "label": "Panel eyebrow" },
    { "type": "text", "id": "bundle_button_label", "label": "Panel button label", "default": "Shop the System" },
    { "type": "header", "content": "Link button" },
    { "type": "text", "id": "link_label", "label": "Link button label" },
    { "type": "url", "id": "link_url", "label": "Link button URL" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }, { "type": "text", "id": "role", "label": "Role badge", "info": "Optional short tag above the title, for example Protect, Balance or Restore." }, { "type": "checkbox", "id": "featured", "label": "Emphasise this card", "default": false }] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product system", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
