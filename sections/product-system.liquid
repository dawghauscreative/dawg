<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--3">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product %}</div>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:56px">
        <a class="btn btn--outline" href="{{ section.settings.link_url | default: routes.collections_url }}">{{ section.settings.link_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product system",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link button label" },
    { "type": "url", "id": "link_url", "label": "Link button URL" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product system", "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
