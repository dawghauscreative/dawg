{%- comment -%}
  Directions are label text, word for word, from metafield custom.directions (falls back to custom.how_it_works). Nothing is added here.
  Bundles show each component's own directions (read from the component product).
{%- endcomment -%}
{%- assign components = product.metafields.custom.bundle_components.value -%}
{%- capture own_text -%}{%- render 'product-directions', p: product -%}{%- endcapture -%}
{%- assign own_text = own_text | strip -%}
{%- assign any_text = false -%}
{%- if own_text != blank -%}{%- assign any_text = true -%}{%- endif -%}
{%- for c in components -%}{%- capture ct -%}{%- render 'product-directions', p: c -%}{%- endcapture -%}{%- if ct != blank -%}{%- assign any_text = true -%}{%- endif -%}{%- endfor -%}
{%- if any_text -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
    <div class="stack" style="--stack:2.5rem">
      {%- if own_text != blank -%}
        <div class="directions">{{ own_text | escape | newline_to_br }}</div>
      {%- endif -%}
      {%- for c in components -%}
        {%- capture ct -%}{%- render 'product-directions', p: c -%}{%- endcapture -%}
        {%- assign ct = ct | strip -%}
        {%- if ct != blank -%}
          <div class="directions">
            <h3 style="margin-bottom:.75rem">{{ c.title }}</h3>
            <p>{{ ct | escape | newline_to_br }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Directions are empty and hidden. Fill metafield custom.directions with the label directions, word for word.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "How it works / how to use",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to use" }
  ],
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
