{%- comment -%}
  All articles. One blog (skin-edu), filtered by tags. On the main page this is the "all articles" list;
  on a tag page (/blogs/skin-edu/tagged/gut-skin) the rest of the hub is hidden and this is the whole page.
{%- endcomment -%}
{%- paginate blog.articles by 9 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" id="all-articles" {{ section.shopify_attributes }}>
  <div class="container blog-listing">
    <div class="section-head">
      {%- if current_tags.size > 0 -%}
        <span class="eyebrow">Skin Edu</span>
        <h1>{{ current_tags.first | replace: '-', ' ' | capitalize }}</h1>
      {%- else -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading | default: blog.title }}</h2>
      {%- endif -%}
    </div>
    {%- if blog.all_tags.size > 0 -%}
      <div class="sci-lib__filters edu-tags" role="navigation" aria-label="Filter articles by topic">
        <a class="sci-chip{% if current_tags.size == 0 %} is-active{% endif %}" href="{{ blog.url }}">All</a>
        {%- for tag in blog.all_tags -%}
          <a class="sci-chip{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | replace: '-', ' ' | capitalize }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if blog.articles.size == 0 -%}
      <p class="lede">{{ section.settings.empty_text }}</p>
    {%- else -%}
      <div class="cols cols--3">
        {%- for article in blog.articles -%}
          <a class="pcard" href="{{ article.url }}">
            <div class="pcard__media" style="aspect-ratio:3/2">{% render 'responsive-image', image: article.image, ratio: '3x2', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.title %}</div>
            <div class="pcard__body">
              <span class="small">{{ article.published_at | date: '%B %-d, %Y' }} &middot; {% render 'read-time', article: article %}</span>
              <h3 class="pcard__title">{{ article.title }}</h3>
              {%- if article.excerpt_or_content != blank -%}<p class="pcard__tagline">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>{%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Skin Edu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All articles" },
    { "type": "text", "id": "empty_text", "label": "Text when there are no articles", "default": "New articles are on the way." }
  ]
}
{% endschema %}
