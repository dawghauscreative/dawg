{%- liquid
  assign systems = 'outdoor-duo,balance-duo,sun-resilience-duo,tria-prima' | split: ','
  assign singles = 'uv-shield,skinbiotic,dermaboost' | split: ','
  assign portal_url = settings.customer_portal_url | default: routes.account_url
  assign shop_all = collections['shop-all'] | default: collections['frontpage']
  assign shop_all_url = shop_all.url | default: routes.all_products_collection_url
-%}

{%- comment -%} Primary nav. Science is a plain link (client review Nov 7). About (Nov 9) holds Founder and Blog (the blog blog). {%- endcomment -%}
<header class="site-header" {{ section.shopify_attributes }}>
  <div class="container site-header__inner">
    <button class="icon-btn menu-toggle" type="button" data-menu-open aria-expanded="false" aria-controls="MenuDrawer" aria-label="{{ 'general.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}" style="width:{{ settings.logo_width }}px">
      {%- else -%}
        <img src="{{ 'alchemia-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | times: 118 | divided_by: 900 }}" style="width:{{ settings.logo_width }}px">
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        <li>
          <details>
            <summary>Shop</summary>
            <div class="nav__panel nav__panel--about">
              <ul>
                <li class="nav__has-sub">
                  <a href="{{ shop_all_url }}">All Products</a>
                  <ul class="nav__sub">
                    {%- if collections['individual-products'] != blank -%}<li><a href="{{ collections['individual-products'].url }}">Individual Formulas</a></li>{%- endif -%}
                    {%- for handle in singles -%}{%- assign p = all_products[handle] -%}{%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}{%- endfor -%}
                  </ul>
                </li>
                <li class="nav__has-sub">
                  <a href="{% if pages['bundles'] != blank %}{{ pages['bundles'].url }}{% elsif collections['bundles'] != blank %}{{ collections['bundles'].url }}{% else %}/pages/bundles{% endif %}">Bundles</a>
                  <ul class="nav__sub">
                    {%- for handle in systems -%}{%- assign p = all_products[handle] -%}{%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}{%- endfor -%}
                  </ul>
                </li>
              </ul>
            </div>
          </details>
        </li>
        <li>
          <details>
            <summary>Learn</summary>
            <div class="nav__panel nav__panel--about">
              <ul>
                <li><a href="/pages/science">Skin Health Science</a></li>
                <li><a href="{{ blogs['blog'].url | default: '/blogs/blog' }}">Blog</a></li>
              </ul>
            </div>
          </details>
        </li>
        <li><a href="/pages/founder">Our Story</a></li>
        <li><a href="/pages/faq">FAQs</a></li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="site-header__portal" href="{{ routes.account_url }}">{% if customer %}Account{% else %}Sign In{% endif %}</a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

</header>

{%- comment -%} The drawer sits outside the header: the header has a backdrop blur, which would make this fixed panel only as tall as the header bar. {%- endcomment -%}
  <div class="drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="drawer__bar">
      <span class="site-header__logo"><img src="{{ settings.logo | default: 'alchemia-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="24" style="width:180px;height:auto"></span>
      <button class="icon-btn" type="button" data-menu-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav aria-label="Mobile">
      <ul>
        <li>
          <span class="drawer__label">Shop</span>
          <ul>
            <li><a href="{{ shop_all_url }}">All Products</a>
              <ul class="drawer__sub">
                {%- for handle in singles -%}{%- assign p = all_products[handle] -%}{%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}{%- endfor -%}
              </ul>
            </li>
            <li><a href="{% if pages['bundles'] != blank %}{{ pages['bundles'].url }}{% elsif collections['bundles'] != blank %}{{ collections['bundles'].url }}{% else %}/pages/bundles{% endif %}">Bundles</a>
              <ul class="drawer__sub">
                {%- for handle in systems -%}{%- assign p = all_products[handle] -%}{%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}{%- endfor -%}
              </ul>
            </li>
          </ul>
        </li>
        <li>
          <span class="drawer__label">Learn</span>
          <ul>
            <li><a href="/pages/science">Skin Health Science</a></li>
            <li><a href="{{ blogs['blog'].url | default: '/blogs/blog' }}">Blog</a></li>
          </ul>
        </li>
        <li><a href="/pages/founder">Our Story</a></li>
        <li><a href="/pages/faq">FAQs</a></li>
        <li><a href="{{ routes.account_url }}">{% if customer %}Account{% else %}Sign In{% endif %}</a></li>
        <li><a href="{{ portal_url }}">{{ settings.manage_subscription_label }}</a></li>
      </ul>
    </nav>
  </div>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "paragraph",
      "content": "One header only. Navigation follows the fixed product handles. Logo, portal link and label are in Theme settings."
    }
  ]
}
{% endschema %}
