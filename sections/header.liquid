{%- liquid
  assign edu_tags = blogs['skin-edu'].all_tags
  assign systems = 'sun-safe-system,skin-recovery-system,sun-resilience-system,complete-skin-defense-system' | split: ','
  assign singles = 'uv-shield,skinbiotic,dermaboost' | split: ','
  assign portal_url = settings.customer_portal_url | default: routes.account_url
  assign shop_all = collections['shop-all'] | default: collections['frontpage']
  assign shop_all_url = shop_all.url | default: routes.all_products_collection_url
-%}

{%- comment -%} Primary nav: Science is a dropdown that also holds the Skin Edu topics. {%- endcomment -%}
<header class="site-header" {{ section.shopify_attributes }}>
  <div class="container site-header__inner">
    <button class="icon-btn menu-toggle" type="button" data-menu-open aria-expanded="false" aria-controls="MenuDrawer" aria-label="{{ 'general.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>
    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | divided_by: settings.logo.aspect_ratio | round }}" style="width:{{ settings.logo_width }}px">
      {%- else -%}
        <img src="{{ 'alchemia-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="{{ settings.logo_width | times: 118 | divided_by: 900 }}" style="width:{{ settings.logo_width }}px">
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        <li>
          <details>
            <summary><a class="nav__shoplink" href="{{ shop_all_url }}">Shop All</a></summary>
            <div class="nav__panel">
              <div>
                <h2>{% if pages['systems'] != blank %}<a href="{{ pages['systems'].url }}">Bundles</a>{% elsif collections['bundles'] != blank %}<a href="{{ collections['bundles'].url }}">Bundles</a>{% else %}Bundles{% endif %}</h2>
                <ul>
                  {%- for handle in systems -%}
                    {%- assign p = all_products[handle] -%}
                    {%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
              <div>
                <h2>{% if collections['individual-products'] != blank %}<a href="{{ collections['individual-products'].url }}">Individual</a>{% else %}Individual{% endif %}</h2>
                <ul>
                  {%- for handle in singles -%}
                    {%- assign p = all_products[handle] -%}
                    {%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          </details>
        </li>
        <li>
          <details>
            <summary><a class="nav__shoplink" href="/pages/science">Science</a></summary>
            <div class="nav__panel nav__panel--science">
              <div>
                <h2><a href="/pages/science">Science</a></h2>
                <ul>
                  <li><a href="/pages/science">The research</a></li>
                  <li><a href="/pages/founder">Meet Dr. Luna</a></li>
                </ul>
              </div>
              <div>
                <h2><a href="/blogs/skin-edu">Skin Edu</a></h2>
                <ul>
                  {%- if edu_tags contains 'skin-science' -%}<li><a href="/blogs/skin-edu/tagged/skin-science">Skin science</a></li>{%- endif -%}{%- if edu_tags contains 'sun-environment' -%}<li><a href="/blogs/skin-edu/tagged/sun-environment">Sun + environment</a></li>{%- endif -%}{%- if edu_tags contains 'gut-skin' -%}<li><a href="/blogs/skin-edu/tagged/gut-skin">Gut + skin</a></li>{%- endif -%}{%- if edu_tags contains 'ingredients' -%}<li><a href="/blogs/skin-edu/tagged/ingredients">Ingredients</a></li>{%- endif -%}{%- if edu_tags contains 'nutrition-wellness' -%}<li><a href="/blogs/skin-edu/tagged/nutrition-wellness">Nutrition + wellness</a></li>{%- endif -%}{%- if edu_tags contains 'ask-the-derm' -%}<li><a href="/blogs/skin-edu/tagged/ask-the-derm">From the derm</a></li>{%- endif -%}
                </ul>
              </div>
            </div>
          </details>
        </li>
        <li><a href="/pages/founder">Founder</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="site-header__portal" href="{{ portal_url }}">{{ settings.manage_subscription_label }}</a>
      <a class="icon-btn" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        {%- if cart.item_count > 0 -%}<span class="cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

</header>

{%- comment -%} The drawer sits outside the header: the header has a backdrop blur, which would make this fixed panel only as tall as the header bar. {%- endcomment -%}
  <div class="drawer" id="MenuDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="drawer__bar">
      <span class="site-header__logo"><img src="{{ settings.logo | default: 'alchemia-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="24" style="width:180px;height:auto"></span>
      <button class="icon-btn" type="button" data-menu-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <nav aria-label="Mobile">
      <ul>
        <li><a href="{{ shop_all_url }}">Shop All</a></li>
        <li>
          <span class="drawer__label">{% if pages['systems'] != blank %}<a href="{{ pages['systems'].url }}" style="font-size:inherit;padding:0">Bundles</a>{% elsif collections['bundles'] != blank %}<a href="{{ collections['bundles'].url }}" style="font-size:inherit;padding:0">Bundles</a>{% else %}Bundles{% endif %}</span>
          <ul>
            {%- for handle in systems -%}
              {%- assign p = all_products[handle] -%}
              {%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <span class="drawer__label">{% if collections['individual-products'] != blank %}<a href="{{ collections['individual-products'].url }}" style="font-size:inherit;padding:0">Individual</a>{% else %}Individual{% endif %}</span>
          <ul>
            {%- for handle in singles -%}
              {%- assign p = all_products[handle] -%}
              {%- if p.title != blank -%}<li><a href="{{ p.url }}">{{ p.title }}</a></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </li>
        <li>
          <a href="/pages/science">Science</a>
          <span class="drawer__label"><a href="/blogs/skin-edu" style="font-size:inherit;padding:0">Skin Edu</a></span>
          <ul>
            {%- if edu_tags contains 'skin-science' -%}<li><a href="/blogs/skin-edu/tagged/skin-science">Skin science</a></li>{%- endif -%}{%- if edu_tags contains 'sun-environment' -%}<li><a href="/blogs/skin-edu/tagged/sun-environment">Sun + environment</a></li>{%- endif -%}{%- if edu_tags contains 'gut-skin' -%}<li><a href="/blogs/skin-edu/tagged/gut-skin">Gut + skin</a></li>{%- endif -%}{%- if edu_tags contains 'ingredients' -%}<li><a href="/blogs/skin-edu/tagged/ingredients">Ingredients</a></li>{%- endif -%}{%- if edu_tags contains 'nutrition-wellness' -%}<li><a href="/blogs/skin-edu/tagged/nutrition-wellness">Nutrition + wellness</a></li>{%- endif -%}{%- if edu_tags contains 'ask-the-derm' -%}<li><a href="/blogs/skin-edu/tagged/ask-the-derm">From the derm</a></li>{%- endif -%}
          </ul>
        </li>
        <li><a href="/pages/founder">Founder</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="{{ portal_url }}">{{ settings.manage_subscription_label }}</a></li>
      </ul>
    </nav>
  </div>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "paragraph",
      "content": "One header only. Navigation follows the fixed product handles. Logo, portal link and label are in Theme settings."
    }
  ]
}
{% endschema %}
