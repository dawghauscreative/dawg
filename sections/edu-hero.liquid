<section class="section scheme-{{ section.settings.color_scheme }} edu-hero{% if section.settings.image != blank or section.settings.image_asset != blank %} edu-hero--media{% endif %}" {{ section.shopify_attributes }}>
  <div class="container edu-hero__grid">
    <div class="edu-hero__inner">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="edu-hero__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      <h2 class="edu-hero__lead">{{ section.settings.heading }}</h2>
      <div class="prose">{{ section.settings.body }}</div>
      <div class="btn-row">
        {%- if section.settings.primary_label != blank -%}<a class="btn" href="{{ section.settings.primary_url }}">{{ section.settings.primary_label }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
      </div>
    </div>
    {%- if section.settings.image != blank or section.settings.image_asset != blank -%}
      <div class="edu-hero__media">{% render 'responsive-image', image: section.settings.image, asset: section.settings.image_asset, asset_width: 1800, asset_height: 1273, ratio: 'natural', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image_alt, loading: 'eager' %}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Skin Edu hero",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Page title (H1)", "default": "Blog" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "text", "id": "primary_url", "label": "Primary button link (anchor or URL)" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "text", "id": "secondary_url", "label": "Secondary button link (anchor or URL)" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "image_asset", "label": "Or theme asset filename", "info": "Shown beside the text, e.g. blog-hero-three-skin-tones.webp" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" }
  ],
  "presets": [{ "name": "Skin Edu hero" }]
}
{% endschema %}
