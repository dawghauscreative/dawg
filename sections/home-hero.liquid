{%- comment -%}
  Homepage hero: copy left (5 columns), Sun Safe System imagery right (7 columns).
  Imagery comes from the picked image, else the featured product's first media, else a theme asset.
  Mobile shows the headline, one short statement, two buttons and the visual only.
{%- endcomment -%}
{%- assign hero_product = section.settings.product -%}
{%- assign hero_media = section.settings.image | default: hero_product.featured_media -%}
<section class="home-hero scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container home-hero__grid">
    <div class="home-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <div class="home-hero__body prose">{{ section.settings.body }}</div>
      <div class="btn-row">
        {%- if section.settings.primary_label != blank -%}<a class="btn" href="{{ section.settings.primary_url | default: hero_product.url }}">{{ section.settings.primary_label }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.secondary_url | default: '/pages/science' }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
      </div>
      {%- if section.settings.trust != blank -%}
        {%- assign trust_items = section.settings.trust | newline_to_br | split: '<br />' -%}
        <ul class="home-hero__trust">{%- for item in trust_items -%}{%- assign t = item | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
      {%- endif -%}
    </div>
    <div class="home-hero__media">
      <span class="home-hero__halo" aria-hidden="true"></span>
      {% render 'responsive-image', image: hero_media, asset: section.settings.asset, asset_width: 1672, asset_height: 941, ratio: '4x5', sizes: '(min-width: 990px) 46vw, 100vw', loading: 'eager', alt: hero_product.title %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text", "info": "Two paragraphs. On mobile only the first is shown." },
    { "type": "text", "id": "primary_label", "label": "Primary button label" },
    { "type": "url", "id": "primary_url", "label": "Primary button link", "info": "Blank = the product page." },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "textarea", "id": "trust", "label": "Trust row (one per line)", "info": "Hidden on mobile." },
    { "type": "product", "id": "product", "label": "Hero product", "info": "Sun Safe System. Its first media is used when no image is picked." },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)", "info": "Dark editorial studio shot of the product(s). No copy baked into the image." },
    { "type": "text", "id": "asset", "label": "Fallback theme asset filename" }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
