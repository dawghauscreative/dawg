<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--3 role-cols" data-scroll-steps="lit">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <article class="role-col" data-step-item {{ block.shopify_attributes }}>
            <div class="role-flip" data-flip>
            <div class="role-flip__inner">
            <a class="role-col__media role-flip__front" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- capture fallback_capture -%}{%- render 'product-fallback-asset', handle: p.handle -%}{%- endcapture -%}
              {%- assign fallback_asset = fallback_capture | strip -%}
              {%- capture front_capture -%}{%- render 'product-front-asset', handle: p.handle -%}{%- endcapture -%}
              {%- assign front_asset = front_capture | strip -%}
              {%- if front_asset != blank -%}
                {% render 'responsive-image', asset: front_asset, asset_width: 1200, asset_height: 1500, ratio: '4x5', sizes: '(min-width: 990px) 30vw, 100vw', alt: p.title %}
              {%- else -%}
                {% render 'responsive-image', image: p.featured_media, asset: fallback_asset, ratio: '4x5', sizes: '(min-width: 990px) 30vw, 100vw', alt: p.title %}
              {%- endif -%}
            </a>
            {%- comment -%} Back of the card (hover on desktop, tap on phones; assets/theme.js "Card flip"). {%- endcomment -%}
            <div class="role-flip__back">
              <span class="role-badge">{{ block.settings.role }}</span>
              <h3 class="role-flip__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
              <p class="role-flip__price">{% if p.price_varies %}From {% endif %}{{ p.price_min | money }}</p>
              {%- if p.metafields.custom.key_ingredients.value != blank -%}
                <p class="role-flip__label">Key ingredients</p>
                {%- render 'product-quickview-ingredients', text: p.metafields.custom.key_ingredients.value, science: pages['science'].url | default: '/pages/science' -%}
              {%- endif -%}
              {%- if p.metafields.custom.summary.value != blank -%}<p class="role-flip__summary">{{ p.metafields.custom.summary.value }}</p>{%- endif -%}
              <a class="btn role-flip__cta" href="{{ p.url }}">Choose your plan</a>
            </div>
            </div>
            </div>
            <div class="role-col__body">
              <span class="role-badge">{{ block.settings.role }}</span>
              <h3>{{ p.title }}</h3>
              {%- if block.settings.tagline != blank -%}<p class="role-col__tagline">{{ block.settings.tagline }}{% if settings.fda_disclaimer_text != blank %}<sup>{{ settings.fda_dagger }}</sup>{% endif %}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              <a class="btn btn--outline" href="{{ p.url }}">{{ block.settings.cta }}</a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Role columns",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Role",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "role", "label": "Role (Protect, Balance, Restore)" },
        { "type": "text", "id": "tagline", "label": "Positioning line" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "text", "id": "cta", "label": "Button label" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Role columns", "blocks": [{ "type": "role" }, { "type": "role" }, { "type": "role" }] }]
}
{% endschema %}
