{%- comment -%}
  Home product showcase (Draft v2): the individual formulas as tan tiles, then one featured system beside a call-out tile.
  Cards link to the product page. No add-to-cart, no quick add. Prices are read from Shopify data. Descriptors are text set here.
{%- endcomment -%}
{%- assign fp = section.settings.featured_product -%}
{%- if section.blocks.size > 0 or fp != blank -%}
<section class="section scheme-{{ section.settings.color_scheme }} showcase" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', heading: section.settings.heading, tag: 'h2' -%}
    {%- if section.blocks.size > 0 -%}
      <div class="showcase__grid showcase__grid--{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a class="showcase-card" href="{{ p.url }}" {{ block.shopify_attributes }}>
              <div class="showcase-card__media">
                {%- if block.settings.asset != blank -%}
                  {%- render 'responsive-image', asset: block.settings.asset, asset_width: 1800, asset_height: 1013, ratio: '1x1', class: 'media--zoom', sizes: '(min-width: 990px) 30vw, 100vw', alt: p.title -%}
                {%- else -%}
                  {%- capture fallback_capture -%}{%- render 'product-fallback-asset', handle: p.handle -%}{%- endcapture -%}
                  {%- assign fallback_asset = fallback_capture | strip -%}
                  {%- render 'responsive-image', image: p.featured_media, asset: fallback_asset, ratio: '1x1', sizes: '(min-width: 990px) 30vw, 100vw', alt: p.title -%}
                {%- endif -%}
              </div>
              <div class="showcase-card__body">
                {%- if block.settings.descriptor != blank -%}<span class="showcase-card__descriptor">{{ block.settings.descriptor }}</span>{%- endif -%}
                <h3 class="showcase-card__title">{{ p.title }}</h3>
                <p class="showcase-card__price">{{ 'products.from' | t }} {{ p.price_min | money_without_trailing_zeros }}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if fp != blank -%}
      <div class="showcase__feature">
        <a class="showcase-card" href="{{ fp.url }}">
          <div class="showcase-card__media">
            {%- if section.settings.featured_asset != blank -%}
              {%- render 'responsive-image', asset: section.settings.featured_asset, asset_width: 1800, asset_height: 1013, ratio: '16x9', sizes: '(min-width: 990px) 40vw, 100vw', alt: fp.title -%}
            {%- else -%}
              {%- capture fallback_capture -%}{%- render 'product-fallback-asset', handle: fp.handle -%}{%- endcapture -%}
              {%- assign fallback_asset = fallback_capture | strip -%}
              {%- render 'responsive-image', image: fp.featured_media, asset: fallback_asset, ratio: '16x9', sizes: '(min-width: 990px) 40vw, 100vw', alt: fp.title -%}
            {%- endif -%}
          </div>
          <div class="showcase-card__body">
            {%- if section.settings.featured_descriptor != blank -%}<span class="showcase-card__descriptor">{{ section.settings.featured_descriptor }}</span>{%- endif -%}
            <h3 class="showcase-card__title">{{ fp.title }}</h3>
            <p class="showcase-card__price">{{ 'products.from' | t }} {{ fp.price_min | money_without_trailing_zeros }}</p>
          </div>
        </a>
        <div class="showcase__callout">
          <h3>{{ section.settings.callout_heading }}</h3>
          {%- if section.settings.callout_label != blank -%}
            <a class="btn" href="{{ section.settings.callout_url | default: routes.collections_url }}">{{ section.settings.callout_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Product showcase has no products yet.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "light", "label": "White" }, { "value": "dark", "label": "Black" }, { "value": "green", "label": "Emerald" }, { "value": "evergreen", "label": "Evergreen" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our products" },
    { "type": "product", "id": "featured_product", "label": "Featured system" },
    { "type": "text", "id": "featured_descriptor", "label": "Featured system descriptor" },
    { "type": "text", "id": "featured_asset", "label": "Featured system image (theme asset filename)", "info": "Optional. Used instead of the product image." },
    { "type": "text", "id": "callout_heading", "label": "Call-out heading" },
    { "type": "text", "id": "callout_label", "label": "Call-out button (15 characters or fewer)" },
    { "type": "url", "id": "callout_url", "label": "Call-out button link" }
  ],
  "blocks": [
    {
      "type": "formula",
      "name": "Formula",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "asset", "label": "Image (theme asset filename)", "info": "Optional. Used instead of the product image." },
        { "type": "text", "id": "descriptor", "label": "Descriptor (small caps line)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product showcase", "blocks": [{ "type": "formula" }, { "type": "formula" }, { "type": "formula" }] }]
}
{% endschema %}
