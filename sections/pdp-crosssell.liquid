{%- assign items = product.metafields.custom.crosssell_products.value -%}
{%- if items.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--{% if items.size == 1 %}2{% else %}3{% endif %}">
      {%- for p in items -%}
        <div>{% render 'product-card', product: p %}</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Cross-sell is empty and hidden. Fill metafield custom.crosssell_products.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Cross-sell",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the system" },
    { "type": "richtext", "id": "body", "label": "Text", "info": "Singles feed bundle AOV, they do not compete. Complete Skin Defense is positioned as an upgrade for the already-converted, never as a must-have for everyone." }
  ],
  "presets": [{ "name": "Cross-sell" }]
}
{% endschema %}
