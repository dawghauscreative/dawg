<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    {%- if section.settings.layout == 'tabs' -%}
      {%- comment -%} Tabs layout (client review Nov 7): full width, one bundle at a time, copy left and image right. {%- endcomment -%}
      <div class="bundle-tabs" data-tabs>
        <div class="bundle-tabs__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            {%- if p != blank -%}
              <button class="bundle-tabs__tab" type="button" role="tab" id="Tab-{{ section.id }}-{{ forloop.index }}" aria-controls="TabPanel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %}>
                <span class="bundle-tabs__name">{{ p.title }}</span>
                {%- if block.settings.roles != blank -%}<span class="bundle-tabs__roles">{{ block.settings.roles }}</span>{%- endif -%}
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- liquid
              case p.handle
                when 'sun-safe-system'
                  assign tab_asset = 'product-3d-uv-shield-skinbiotic.webp'
                when 'skin-recovery-system'
                  assign tab_asset = 'product-3d-skinbiotic-dermaboost.webp'
                when 'sun-resilience-system'
                  assign tab_asset = 'product-3d-uv-shield-dermaboost.webp'
                when 'complete-skin-defense-system'
                  assign tab_asset = 'product-3d-trio.webp'
                else
                  assign tab_asset = block.settings.asset
              endcase
            -%}
            <div class="bundle-tab" role="tabpanel" id="TabPanel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
              <div class="bundle-tab__copy">
                {%- if block.settings.roles != blank -%}<span class="eyebrow">{{ block.settings.roles }}</span>{%- endif -%}
                <h3>{{ p.title }}</h3>
                <p class="lede">{{ block.settings.best_for }}</p>
                {%- if block.settings.note != blank -%}<p class="small">{{ block.settings.note }}</p>{%- endif -%}
                <a class="btn" href="{{ p.url }}">{{ block.settings.cta | default: 'Explore' }}</a>
              </div>
              <a class="bundle-tab__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% render 'responsive-image', image: block.settings.image, asset: tab_asset, asset_width: 1200, asset_height: 1500, ratio: '4x5', sizes: '(min-width: 990px) 40vw, 100vw', alt: p.title %}</a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
    <div class="cols cols--auto4 finder" data-scroll-slide>
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <article class="finder-card{% if block.settings.featured %} finder-card--featured{% endif %}" data-qv-card {{ block.shopify_attributes }}>
            {%- render 'product-quickview', product: p -%}
            <a class="finder-card__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% render 'responsive-image', image: block.settings.image, asset: block.settings.asset, asset_width: 1400, asset_height: 787, ratio: '16x9', sizes: '(min-width: 990px) 25vw, 100vw', alt: p.title %}</a>
            <div class="finder-card__body">
              <h3>{{ p.title }}</h3>
              <p class="finder-card__roles">{{ block.settings.roles }}</p>
              <p>{% if section.settings.best_for_label != blank %}<strong>{{ section.settings.best_for_label }}</strong> {% endif %}{{ block.settings.best_for }}</p>
              {%- if block.settings.note != blank -%}<p class="small">{{ block.settings.note }}</p>{%- endif -%}
              <a class="btn btn--outline" href="{{ p.url }}">{{ block.settings.cta }}</a>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:48px"><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "System finder",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "select", "id": "layout", "label": "Layout", "default": "cards", "options": [{ "value": "cards", "label": "Cards" }, { "value": "tabs", "label": "Tabs (one bundle at a time, full width)" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "text", "id": "best_for_label", "label": "Label before each description", "default": "Best for:", "info": "Leave empty to show the description only." }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System",
      "settings": [
        { "type": "product", "id": "product", "label": "System" },
        { "type": "text", "id": "roles", "label": "Roles (e.g. Protect + Balance)" },
        { "type": "textarea", "id": "best_for", "label": "Best for" },
        { "type": "text", "id": "note", "label": "Compliance line (optional)", "info": "Empty = hidden. Use for a system-specific statement once approved." },
        { "type": "text", "id": "cta", "label": "Button label" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Fallback theme asset filename" },
        { "type": "checkbox", "id": "featured", "label": "Emphasise this card", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "System finder", "blocks": [{ "type": "system" }, { "type": "system" }, { "type": "system" }, { "type": "system" }] }]
}
{% endschema %}
