{%- comment -%}
  Curated article cards. Each card names an article by handle: it becomes a link once that article is published
  in the blog and shows "Coming soon" until then. A card can also link to any URL (e.g. a product page).
  Read time is calculated from the real article; it is never made up for articles that do not exist yet.
{%- endcomment -%}
<section class="section {% if section.settings.color_scheme == 'charcoal' %}scheme-dark {% endif %}scheme-{{ section.settings.color_scheme }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--auto4 edu-cards edu-cards--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign ah = block.settings.article | strip -%}
        {%- assign a = '' -%}
        {%- if ah != blank -%}{%- assign akey = section.settings.blog_handle | append: '/' | append: ah -%}{%- assign a = articles[akey] -%}{%- endif -%}
        {%- assign href = block.settings.url -%}
        {%- if a != blank -%}{%- assign href = a.url -%}{%- endif -%}
        {%- assign has_media = false -%}
        {%- if block.settings.image != blank or block.settings.asset != blank -%}{%- assign has_media = true -%}{%- endif -%}
        {%- liquid
          assign fp = blank
          if section.settings.flip and href contains '/products/'
            assign fp_handle = href | split: '/products/' | last | split: '?' | first | split: '#' | first
            assign fp = all_products[fp_handle]
          endif
        -%}
        {%- if fp != blank -%}<div class="role-flip edu-flip" data-flip {{ block.shopify_attributes }}><div class="role-flip__inner">{%- endif -%}
        <article class="edu-card{% if href == blank %} edu-card--soon{% endif %}{% if has_media %} edu-card--media{% endif %}{% if fp != blank %} role-flip__front{% endif %}"{% if fp == blank %} {{ block.shopify_attributes }}{% endif %}>
          {%- if has_media -%}
            {%- if href != blank -%}<a class="edu-card__img" href="{{ href }}" tabindex="-1" aria-hidden="true">{%- else -%}<div class="edu-card__img">{%- endif -%}
              {% render 'responsive-image', image: block.settings.image, asset: block.settings.asset, ratio: '4x5', sizes: '(min-width: 1000px) 30vw, (min-width: 750px) 45vw, 100vw', alt: block.settings.title %}
            {%- if href != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endif -%}
          <div class="edu-card__text">
          {%- if block.settings.category != blank -%}<span class="role-badge">{{ block.settings.category }}</span>{%- endif -%}
          <h3>{%- if href != blank -%}<a href="{{ href }}">{{ block.settings.title }}</a>{%- else -%}{{ block.settings.title }}{%- endif -%}</h3>
          {%- if block.settings.teaser != blank -%}<p>{{ block.settings.teaser }}</p>{%- endif -%}
          <p class="edu-card__meta">
            {%- if a != blank -%}<span>{% render 'read-time', article: a %}</span>{%- endif -%}
            {%- if href != blank -%}<a class="text-link" href="{{ href }}">{{ block.settings.cta_label | default: 'Read article' }} &rarr;</a>{%- else -%}<span class="edu-card__soon">Coming soon</span>{%- endif -%}
          </p>
          </div>
        </article>
        {%- if fp != blank -%}
          {%- comment -%} Back of the card (hover on desktop, tap on phones; assets/theme.js "Card flip"). {%- endcomment -%}
          <div class="role-flip__back">
            {%- if block.settings.category != blank -%}<span class="role-badge">{{ block.settings.category }}</span>{%- endif -%}
            <h3 class="role-flip__title"><a href="{{ fp.url }}">{{ fp.title }}</a></h3>
            <p class="role-flip__price">{% if fp.price_varies %}From {% endif %}{{ fp.price_min | money }}</p>
            {%- if fp.metafields.custom.key_ingredients.value != blank -%}
              <p class="role-flip__label">Key ingredients</p>
              {%- assign flip_science = pages['science'].url | default: '/pages/science' -%}
              {%- render 'product-quickview-ingredients', text: fp.metafields.custom.key_ingredients.value, science: flip_science -%}
            {%- endif -%}
            {%- if fp.metafields.custom.summary.value != blank -%}<p class="role-flip__summary">{{ fp.metafields.custom.summary.value }}</p>{%- endif -%}
            <a class="btn role-flip__cta" href="{{ fp.url }}">Choose your plan</a>
          </div>
          </div></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:48px"><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Skin Edu articles",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "charcoal", "label": "Charcoal" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "anchor", "label": "Anchor id (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Cards per row", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "blog" },
    { "type": "checkbox", "id": "flip", "label": "Flip product cards", "info": "Cards linking to a product page flip on hover (tap on phones) to show price, key ingredients and Choose your plan.", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (4:5)" },
        { "type": "text", "id": "asset", "label": "Or theme asset filename", "info": "Used when no image is picked." },
        { "type": "text", "id": "category", "label": "Category label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "teaser", "label": "Teaser (1 to 2 sentences)" },
        { "type": "text", "id": "article", "label": "Article handle", "info": "Links once the article is published." },
        { "type": "url", "id": "url", "label": "Or link to any page" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read article" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Skin Edu articles" }]
}
{% endschema %}
