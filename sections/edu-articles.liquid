{%- comment -%}
  Curated article cards. Each card names an article by handle: it becomes a link once that article is published
  in the blog and shows "Coming soon" until then. A card can also link to any URL (e.g. a product page).
  Read time is calculated from the real article; it is never made up for articles that do not exist yet.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %} {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--auto4 edu-cards edu-cards--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign ah = block.settings.article | strip -%}
        {%- assign a = '' -%}
        {%- if ah != blank -%}{%- assign akey = section.settings.blog_handle | append: '/' | append: ah -%}{%- assign a = articles[akey] -%}{%- endif -%}
        {%- assign href = block.settings.url -%}
        {%- if a != blank -%}{%- assign href = a.url -%}{%- endif -%}
        <article class="edu-card{% if href == blank %} edu-card--soon{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.category != blank -%}<span class="role-badge">{{ block.settings.category }}</span>{%- endif -%}
          <h3>{%- if href != blank -%}<a href="{{ href }}">{{ block.settings.title }}</a>{%- else -%}{{ block.settings.title }}{%- endif -%}</h3>
          {%- if block.settings.teaser != blank -%}<p>{{ block.settings.teaser }}</p>{%- endif -%}
          <p class="edu-card__meta">
            {%- if a != blank -%}<span>{% render 'read-time', article: a %}</span>{%- endif -%}
            {%- if href != blank -%}<a class="text-link" href="{{ href }}">{{ block.settings.cta_label | default: 'Read article' }} &rarr;</a>{%- else -%}<span class="edu-card__soon">Coming soon</span>{%- endif -%}
          </p>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:48px"><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Skin Edu articles",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "anchor", "label": "Anchor id (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Cards per row", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "blog_handle", "label": "Blog handle", "default": "skin-edu" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article card",
      "settings": [
        { "type": "text", "id": "category", "label": "Category label" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "teaser", "label": "Teaser (1 to 2 sentences)" },
        { "type": "text", "id": "article", "label": "Article handle", "info": "Links once the article is published." },
        { "type": "url", "id": "url", "label": "Or link to any page" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "Read article" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Skin Edu articles" }]
}
{% endschema %}
