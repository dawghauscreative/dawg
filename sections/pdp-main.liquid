{%- comment -%}
  Shared product hero for ALL 7 product pages. Differences come from product data (metafields)
  and which blocks each template enables.

  BUY BOX RULES (Supr owns the buy box):
  - The widget sits INSIDE the form that posts to /cart/add. This form is a normal HTML form post:
    no JS add-to-cart, no hand-built payload. The whole form (including any selling plan Supr adds) goes with it.
  - We never write a selling_plan input. We never render a quantity input or a custom subscription picker.
  - Each product keeps ONE default variant (no "Supply" variants: stock is tracked per variant). The four options
    (Monthly, 3-Month subscription, One-Time 3-Month qty 3, One-Time Single) are configured in the Supr dashboard.
  - No dynamic checkout / Buy it now button.
  - Supr's "Subscriptions + Bundles" app block, if added in the editor, is rendered inside the form.
  - The Supr app embed (Theme editor > App embeds) must be ON for this theme.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign featured = product.featured_media
-%}

<section class="pdp scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="pdp__grid">

      <div class="pdp__gallery" data-gallery>
        {%- if featured != blank -%}
          <div class="media ratio-4x5">
            <img
              data-gallery-main
              src="{{ featured | image_url: width: 1100 }}"
              srcset="{{ featured | image_url: width: 600 }} 600w, {{ featured | image_url: width: 900 }} 900w, {{ featured | image_url: width: 1200 }} 1200w, {{ featured | image_url: width: 1600 }} 1600w"
              sizes="(min-width: 990px) 56vw, 100vw"
              alt="{{ featured.alt | default: product.title | escape }}"
              width="{{ featured.width }}" height="{{ featured.height }}"
              loading="eager" fetchpriority="high">
          </div>
          {%- assign extra_assets = section.settings.gallery_assets | split: ',' -%}
          {%- if product.media.size > 1 or extra_assets.size > 0 -%}
            <div class="pdp__thumbs">
              {%- for media in product.media limit: 10 -%}
                {%- if media.media_type == 'image' -%}
                  <button type="button" data-thumb data-src="{{ media | image_url: width: 1100 }}" data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w" aria-label="Show image {{ forloop.index }}" aria-current="{% if media.id == featured.id %}true{% else %}false{% endif %}">
                    <img src="{{ media | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
                  </button>
                {%- endif -%}
              {%- endfor -%}
              {%- for asset_name in extra_assets -%}
                {%- assign asset_clean = asset_name | strip -%}
                {%- if asset_clean != blank -%}
                  <button type="button" data-thumb data-src="{{ asset_clean | asset_url }}" aria-label="Show graphic {{ forloop.index }}" aria-current="false"><img src="{{ asset_clean | asset_url }}" alt="" width="100" height="125" loading="lazy"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- capture fallback_capture -%}{%- render 'product-fallback-asset', handle: product.handle -%}{%- endcapture -%}
          {%- assign fallback_asset = fallback_capture | strip -%}
          {% render 'responsive-image', asset: fallback_asset, ratio: '4x5', sizes: '(min-width: 990px) 56vw, 100vw', loading: 'eager', alt: product.title %}
        {%- endif -%}
      </div>

      <div class="pdp__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.eyebrow != blank -%}<span class="eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
                <h1 class="pdp__title">{{ product.title }}</h1>
              </div>

            {%- when 'tagline' -%}
              {%- if product.metafields.custom.tagline != blank -%}
                <p class="pdp__tagline" {{ block.shopify_attributes }}>{{ product.metafields.custom.tagline }}{% if settings.fda_disclaimer_text != blank %}<sup>{{ settings.fda_dagger }}</sup>{% endif %}</p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- comment -%} First paragraph of the Shopify product description (Admin > Products). Internal HTML comments are stripped. {%- endcomment -%}
              {%- liquid
                assign d_segs = product.description | split: '<!--'
                assign d_clean = d_segs[0]
                for d_seg in d_segs offset: 1
                  assign d_tail = d_seg | split: '-->' | last
                  assign d_clean = d_clean | append: d_tail
                endfor
                assign d_intro = d_clean | split: '<h3>' | first
                assign d_paras = d_intro | split: '</p>'
                assign d_short = ''
                for d_para in d_paras offset: 1 limit: 1
                  assign d_short = d_para | append: '</p>'
                endfor
              -%}
              {%- if block.settings.text != blank -%}
                <div class="pdp__desc prose" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- elsif d_short != blank -%}<div class="pdp__desc prose" {{ block.shopify_attributes }}>{{ d_short }}</div>{%- endif -%}

            {%- when 'bullets' -%}
              {%- assign bullet_list = block.settings.items | newline_to_br | split: '<br />' -%}
              <ul class="pdp__bullets" {{ block.shopify_attributes }}>{%- for b in bullet_list -%}{%- assign b_text = b | strip -%}{%- if b_text != blank -%}<li>{{ b_text }}</li>{%- endif -%}{%- endfor -%}</ul>

            {%- when 'note' -%}
              {%- if block.settings.text != blank -%}<p class="pdp__note small" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>{%- endif -%}

            {%- when 'price' -%}
              {%- comment -%} Base price read from Shopify data. Hide with Theme settings > Product pages once Supr's widget shows pricing. {%- endcomment -%}
              {%- if settings.show_base_price -%}
                <p class="pdp__price" {{ block.shopify_attributes }}>{% render 'price', product: product %}</p>
              {%- endif -%}

            {%- when 'reviews' -%}
              {%- comment -%} Review summary slot. Renders nothing until a reviews app is on. {%- endcomment -%}
              <div class="reviews-slot pdp__reviews" data-reviews-summary {{ block.shopify_attributes }}></div>

            {%- when 'buy_buttons' -%}
              <div class="buy-box" id="buy-box" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'buy-form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="product-id" value="{{ product.id }}">
                  {%- comment -%} One default variant per product. Supr's widget supplies the plan/quantity choices; this input is only the variant it posts. {%- endcomment -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- comment -%} Supr app block(s), if placed in the theme editor, render inside the form. {%- endcomment -%}
                  {%- for app_block in section.blocks -%}
                    {%- if app_block.type == '@app' -%}{% render app_block %}{%- endif -%}
                  {%- endfor -%}

                  <button type="submit" name="add" class="btn btn--block" {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
                    {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                  </button>
                  {%- comment -%} Dynamic checkout buttons are intentionally NOT rendered on product pages. {%- endcomment -%}
                {%- endform -%}
                {%- if settings.show_three_month_placeholder and settings.three_month_placeholder_text != blank -%}
                  <p class="price-placeholder small" role="note">{{ settings.three_month_placeholder_text }}</p>
                {%- endif -%}
                {%- render 'guarantee-badge', style: 'line' -%}
              </div>

            {%- when 'expectation' -%}
              {%- assign expect_line = block.settings.text | default: settings.renewal_expectation_line -%}
              {%- if settings.show_renewal_timeline and expect_line != blank -%}
                <p class="expectation" {{ block.shopify_attributes }}>{{ expect_line }}</p>
              {%- elsif request.design_mode and settings.show_renewal_timeline -%}
                <p class="expectation small" {{ block.shopify_attributes }}>[Editor only] Expectation line is empty. Add it on this block or in Theme settings &gt; Your Renewal Timeline.</p>
              {%- endif -%}

            {%- when 'trust_bar' -%}
              {%- capture trust_items -%}
                {%- for i in (1..3) -%}
                  {%- assign t_key = 'text_' | append: i -%}
                  {%- assign i_key = 'icon_' | append: i -%}
                  {%- if block.settings[t_key] != blank -%}
                    <div><span class="icon">{% render 'icon', name: block.settings[i_key] %}</span><span>{{ block.settings[t_key] }}</span></div>
                  {%- endif -%}
                {%- endfor -%}
                {%- render 'guarantee-badge', style: 'trust' -%}
              {%- endcapture -%}
              {%- if trust_items contains '<div' -%}
                <div class="trust-bar" {{ block.shopify_attributes }}>{{ trust_items }}</div>
              {%- endif -%}

            {%- when 'melanoma' -%}
              {%- comment -%} Only wording verified on the packaging. No amounts, no percentages. {%- endcomment -%}
              {%- if settings.melanoma_line_text != blank -%}
                <p class="small" {{ block.shopify_attributes }}>{{ settings.melanoma_line_text }}</p>
              {%- endif -%}

            {%- when 'fda' -%}
              <div {{ block.shopify_attributes }}>{% render 'fda-disclaimer', dagger: true %}</div>

            {%- when 'compliance_slot' -%}
              <div {{ block.shopify_attributes }}>{% render 'compliance-slot', content: product.metafields.custom.compliance_slot %}</div>

          {%- endcase -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

{%- comment -%}
  Sticky CTA: a scroll-to-buy-box link. NOT an add-to-cart, NOT a Buy it now button, never submits a form.
  Add to cart always goes through the main form above.
{%- endcomment -%}
<div class="sticky-cta" data-sticky-cta aria-hidden="true" inert>
  <span class="sticky-cta__title">{{ product.title }}</span>
  <a class="btn" href="#buy-box" data-sticky-scroll>{{ settings.sticky_cta_label }}</a>
</div>

{% schema %}
{
  "name": "Product hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "gallery_assets", "label": "Extra gallery graphics (theme asset filenames, comma separated)", "info": "Appended after the product media, e.g. slide-d01-1.webp, slide-d02-1.webp" },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1, "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow (above the title)" }] },
    { "type": "tagline", "name": "Tagline", "limit": 1 },
    { "type": "description", "name": "Short description", "limit": 1, "settings": [{ "type": "richtext", "id": "text", "label": "Override text", "info": "Blank = first paragraph of the Shopify product description." }] },
    { "type": "bullets", "name": "Benefit bullets", "limit": 1, "settings": [{ "type": "textarea", "id": "items", "label": "Bullets (one per line)" }] },
    { "type": "note", "name": "Small note", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "reviews", "name": "Review summary slot", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1 },
    { "type": "expectation", "name": "Expectation line", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Override text", "info": "Blank = the line in Theme settings > Your Renewal Timeline." }] },
    {
      "type": "trust_bar",
      "name": "Trust bar",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Up to three items. Leave empty until copy is approved. The guarantee cell appears only when the guarantee is switched on in Theme settings." },
        { "type": "select", "id": "icon_1", "label": "Icon 1", "default": "shield", "options": [{ "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "text_1", "label": "Text 1" },
        { "type": "select", "id": "icon_2", "label": "Icon 2", "default": "molecule", "options": [{ "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "text_2", "label": "Text 2" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "default": "cell", "options": [{ "value": "molecule", "label": "Molecule" }, { "value": "cell", "label": "Cell" }, { "value": "shield", "label": "Shield" }, { "value": "layers", "label": "Layers" }] },
        { "type": "text", "id": "text_3", "label": "Text 3" }
      ]
    },
    { "type": "melanoma", "name": "Melanoma research line", "limit": 1 },
    { "type": "fda", "name": "FDA dagger line", "limit": 1 },
    { "type": "compliance_slot", "name": "Product compliance slot", "limit": 1 },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Product hero" }]
}
{% endschema %}
