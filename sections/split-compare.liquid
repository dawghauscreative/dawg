{%- comment -%} Two-sided concept (e.g. prebiotic + probiotics = synbiotic) with a centre statement. {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="compare{% if section.blocks.size > 2 %} compare--3{% endif %}">
      {%- for block in section.blocks limit: 3 -%}
        <article class="compare__side" {{ block.shopify_attributes }}>
          <span class="compare__kicker">{{ block.settings.kicker }}</span>
          <h3>{{ block.settings.name }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.items != blank -%}
            <ul class="compare__list">{%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}{%- for it in items -%}{%- assign t = it | strip -%}{%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}</ul>
          {%- endif -%}
          {%- if block.settings.focus != blank -%}<p class="compare__focus"><strong>Primary focus</strong> {{ block.settings.focus }}</p>{%- endif -%}
        </article>
        {%- if forloop.first and section.blocks.size < 3 -%}<span class="compare__plus" aria-hidden="true">+</span>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.center != blank -%}<p class="compare__center">{{ section.settings.center }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div class="btn-row" style="justify-content:center;margin-top:48px"><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Split compare",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "center", "label": "Centre statement" },
    { "type": "text", "id": "button_label", "label": "Button label (optional)" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "blocks": [
    { "type": "side", "name": "Side", "settings": [{ "type": "text", "id": "kicker", "label": "Label" }, { "type": "text", "id": "name", "label": "Title" }, { "type": "textarea", "id": "text", "label": "Text" }, { "type": "textarea", "id": "items", "label": "List (one per line)" }, { "type": "text", "id": "focus", "label": "Primary focus line" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Split compare", "blocks": [{ "type": "side" }, { "type": "side" }] }]
}
{% endschema %}
