{%- comment -%}
  Ingredient library for the Science page. Reads the same ingredient records used on each product page
  (custom.ingredients). No Tier 2 research links. Nothing is written here.
{%- endcomment -%}
{%- assign any = false -%}
{%- for block in section.blocks -%}
  {%- if block.settings.product.metafields.custom.ingredients.value.size > 0 -%}{%- assign any = true -%}{%- endif -%}
{%- endfor -%}
{%- if any -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="stack" style="--stack:4rem">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign items = p.metafields.custom.ingredients.value -%}
        {%- if items.size > 0 -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="lib__title"><a href="{{ p.url }}">{{ p.title }}</a>{% if block.settings.role != blank %} <span class="role-badge">{{ block.settings.role }}</span>{% endif %}</h3>
            <div class="cols cols--3">
              {%- for ingredient in items -%}
                <article class="ingredient">
                  {% render 'responsive-image', image: ingredient.image.value, ratio: '4x5', sizes: '(min-width: 750px) 30vw, 100vw', alt: ingredient.name.value %}
                  {%- if ingredient.role.value != blank -%}<span class="ingredient__role">{{ ingredient.role.value }}</span>{%- endif -%}
                  <h4>{{ ingredient.name.value }}</h4>
                  {%- if ingredient.amount.value != blank -%}<p class="ingredient__amount">{{ ingredient.amount.value }}</p>{%- endif -%}
                  {%- if ingredient.description.value != blank -%}<p>{{ ingredient.description.value }}</p>{%- endif -%}
                </article>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Ingredient library",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }, { "type": "text", "id": "role", "label": "Role badge" }] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Ingredient library" }]
}
{% endschema %}
