{%- comment -%}
  Three overlapping domains (Tria Prima). Same interactive Venn as the Science page (client review Nov 7): centred, hover or tap
  a circle to slide in that domain's primary and supporting formulas; the centre shows the complete routine. Use "|" in a short
  label to break it onto two lines.
{%- endcomment -%}
{%- assign pos = '300,98|176,392|424,392' | split: '|' -%}
{%- assign keys = 'a,b,c' | split: ',' -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="venn" data-venn data-venn-mode="nearest">
      <div class="venn__stage">
        <svg class="venn__svg" viewBox="0 0 600 510" role="group" aria-label="Three domains: hover or tap to explore" data-venn-svg>
          <g class="venn__circles" stroke="var(--c-gold)" stroke-width="1.5" fill="var(--c-gold)">
            <circle data-venn-circle="a" cx="300" cy="175" r="150"/>
            <circle data-venn-circle="b" cx="213" cy="325" r="150"/>
            <circle data-venn-circle="c" cx="387" cy="325" r="150"/>
          </g>
          <g class="venn__labels" fill="currentColor" text-anchor="middle">
            {%- for block in section.blocks limit: 3 -%}
              {%- assign c = pos[forloop.index0] | split: ',' -%}
              {%- assign lines = block.settings.short | split: '|' -%}
              <g tabindex="0" role="button" aria-label="{{ block.settings.title | escape }}" data-venn-focus="{{ keys[forloop.index0] }}" class="venn__label">
                {%- for line in lines -%}
                  {%- assign dy = forloop.index0 | times: 28 -%}
                  <text x="{{ c[0] }}" y="{{ c[1] | plus: dy }}" class="venn__title venn__title--sm">{{ line | strip }}</text>
                {%- endfor -%}
              </g>
            {%- endfor -%}
            <text x="300" y="300" class="venn__center">{{ section.settings.center }}</text>
          </g>
          <g class="venn__dots">
            <g class="venn__dot" tabindex="0" role="button" aria-label="{{ section.settings.center | escape }}" data-venn-focus="abc"><circle cx="300" cy="266" r="11"/><path d="M294 266h12M300 260v12"/></g>
          </g>
        </svg>
        <p class="venn__hint">Hover or tap the circles to explore</p>
      </div>
      <div class="venn__panels" aria-live="polite">
        {%- for block in section.blocks limit: 3 -%}
          <article class="venn__panel" data-venn-panel="{{ keys[forloop.index0] }}" {{ block.shopify_attributes }}>
            <span class="venn__eyebrow">{{ block.settings.short | replace: '|', ' ' }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p class="venn__row"><strong>Primary</strong> {% render 'link-product-names', text: block.settings.primary %}</p>
            <p class="venn__row"><strong>Supporting</strong> {% render 'link-product-names', text: block.settings.supporting %}</p>
          </article>
        {%- endfor -%}
        <article class="venn__panel" data-venn-panel="abc">
          <span class="venn__eyebrow">{{ section.settings.center }}</span>
          <div class="prose">{% render 'link-product-names', text: section.settings.center_text %}</div>
        </article>
      </div>
    </div>
    {%- if section.settings.caption != blank -%}<p class="sci-caption">{{ section.settings.caption }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Domain circles",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "center", "label": "Centre label", "default": "COMPLETE" },
    { "type": "richtext", "id": "center_text", "label": "Centre info (shown on hover)", "default": "<p>Tria Prima brings UV Shield+, Skinbiotic+ and Dermaboost+ together. Each formula leads in one area and supports the others.</p>" },
    { "type": "textarea", "id": "caption", "label": "Caption" }
  ],
  "blocks": [
    { "type": "domain", "name": "Domain", "settings": [{ "type": "text", "id": "short", "label": "Short label (inside the circle)", "info": "Use | to break onto two lines, e.g. Gut|microbial." }, { "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "primary", "label": "Primary formula" }, { "type": "text", "id": "supporting", "label": "Supporting formula(s)" }] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Domain circles" }]
}
{% endschema %}
