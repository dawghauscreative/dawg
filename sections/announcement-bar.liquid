{%- if section.settings.text != blank -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    {%- if section.settings.url != blank -%}<a href="{{ section.settings.url }}">{{ section.settings.text }}</a>{%- else -%}{{ section.settings.text }}{%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <div class="announcement" {{ section.shopify_attributes }}>[Editor only] Announcement bar is empty and hidden.</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "info": "Empty = hidden. Do not put prices or discount figures here unless approved." },
    { "type": "url", "id": "url", "label": "Link" }
  ]
}
{% endschema %}
