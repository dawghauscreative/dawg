{%- comment -%}
  Bundle layout: Step 1 / Step 2 / Step 3 from custom.bundle_components (product refs, in order).
  Complete Skin Defense is positioned as an upgrade for the already-converted, never as a must-have for everyone.
{%- endcomment -%}
{%- assign components = product.metafields.custom.bundle_components.value -%}
{%- if components.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="steps">
      {%- for c in components -%}
        <article class="step">
          <div class="step__media">{% render 'responsive-image', image: c.featured_media, ratio: '4x5', sizes: '220px', alt: c.title %}</div>
          <div class="stack" style="--stack:.75rem">
            <span class="step__num"><span class="step__badge">{{ forloop.index }}</span>{{ section.settings.step_label }} {{ forloop.index }}</span>
            <h3>{{ c.title }}</h3>
            {%- if c.metafields.custom.tagline != blank -%}<p>{{ c.metafields.custom.tagline }}</p>{%- endif -%}
            <a class="text-link" href="{{ c.url }}">View product</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Bundle steps are hidden. Fill metafield custom.bundle_components on this bundle.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Bundle steps",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's included" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "step_label", "label": "Step label", "default": "Step" }
  ],
  "presets": [{ "name": "Bundle steps" }]
}
{% endschema %}
