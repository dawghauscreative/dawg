<section class="password scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container password__inner">
    <img class="password__logo" src="{{ 'alchemia-logo-white.png' | asset_url }}" alt="{{ shop.name }}" width="320" height="42">
    {%- if section.settings.heading != blank -%}
      <h1 class="password__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="password__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label class="visually-hidden" for="Password">Password</label>
      <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="Password" required>
      <button type="submit" class="btn">Enter</button>
    {%- endform -%}

    <p class="small password__foot">{{ settings.mailing_address }}{% if settings.support_email != blank %} &middot; <a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>{% endif %}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "band", "label": "Black to emerald" }, { "value": "green", "label": "Evergreen" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Enter the password to preview the store." }
  ]
}
{% endschema %}
