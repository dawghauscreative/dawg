{%- comment -%}
  Compliance area on every PDP: product compliance slot (empty/hidden by default), label caution line, FDA disclaimer.
  The slot format (lower-third vs voiced line) is not decided; this is only the on-page text slot.
{%- endcomment -%}
<section class="section--tight scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:960px">
    {%- render 'compliance-slot', content: product.metafields.custom.compliance_slot -%}
    <div class="stack" style="--stack:.75rem;margin-top:2rem">
      {%- if section.settings.extra_line != blank -%}<p class="small">{{ section.settings.extra_line }}</p>{%- endif -%}
      {%- render 'label-caution' -%}
      {%- if section.settings.fda_text != blank -%}<p class="fda-line"><span aria-hidden="true">{{ settings.fda_dagger }}</span> {{ section.settings.fda_text }}</p>{%- else -%}{%- render 'fda-disclaimer', dagger: true -%}{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compliance notice",
  "settings": [
    { "type": "text", "id": "extra_line", "label": "Extra line (e.g. sunscreen statement)" },
    { "type": "textarea", "id": "fda_text", "label": "FDA wording override (optional)", "info": "Blank = the standard wording in Theme settings > Compliance. Use for pages that cover several products." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] }
  ],
  "presets": [{ "name": "Compliance notice" }]
}
{% endschema %}
