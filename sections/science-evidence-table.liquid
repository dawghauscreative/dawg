<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="sci-table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="sci-table__row sci-table__row--head" role="row">
        <span role="columnheader">Research area</span><span role="columnheader">Current evidence</span><span role="columnheader">How we interpret it</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="sci-table__row" role="row" {{ block.shopify_attributes }}>
          <strong role="cell">{{ block.settings.area }}</strong>
          <span role="cell" data-label="Current evidence"><i class="sci-dots sci-dots--{{ block.settings.level }}" aria-hidden="true"></i>{{ block.settings.evidence }}</span>
          <span role="cell" data-label="How we interpret it">{{ block.settings.interpretation }}</span>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.legend != blank -%}<p class="sci-caption">{{ section.settings.legend }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Evidence table",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "textarea", "id": "legend", "label": "Legend" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "area", "label": "Research area" },
        { "type": "text", "id": "evidence", "label": "Current evidence" },
        { "type": "select", "id": "level", "label": "Evidence maturity (dots)", "default": "3", "options": [{ "value": "1", "label": "1: Emerging / preclinical" }, { "value": "2", "label": "2: Growing, mixed or strain-specific" }, { "value": "3", "label": "3: Human evidence" }, { "value": "4", "label": "4: Extensive" }] },
        { "type": "textarea", "id": "interpretation", "label": "How we interpret it" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Evidence table" }]
}
{% endschema %}
