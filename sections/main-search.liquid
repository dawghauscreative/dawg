{%- paginate search.results by 12 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="section-head">
      <h1>{{ section.settings.heading }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:2rem;display:flex;gap:12px;flex-wrap:wrap">
        <div class="field" style="flex:1;min-width:240px"><label for="SearchInput" class="visually-hidden">{{ 'general.search' | t }}</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search' | t }}"></div>
        <button class="btn" type="submit">{{ 'general.search' | t }}</button>
      </form>
    </div>
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="lede">{{ section.settings.empty_text }}</p>
      {%- else -%}
        <div class="cols cols--3">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <div>{% render 'product-card', product: item %}</div>
            {%- else -%}
              <a class="card" href="{{ item.url }}" style="text-decoration:none"><h3>{{ item.title }}</h3></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "empty_text", "label": "No results text", "default": "No results found." }
  ]
}
{% endschema %}
