{%- comment -%}
  Value stack + large CTA for bundle pages. Every figure is read from Shopify product data.
  No savings are computed or hard-coded: Supr applies subscription and quantity discounts in its widget.
{%- endcomment -%}
{%- assign components = product.metafields.custom.bundle_components.value -%}
{%- if components.size > 0 -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container" style="max-width:960px">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="value-stack">
      {%- for c in components -%}
        <div class="value-row">
          <span>{{ c.title }}</span>
          <span>{% render 'price', product: c %}</span>
        </div>
      {%- endfor -%}
      <div class="value-row">
        <strong style="font-family:var(--font-display);font-size:1.6rem;font-weight:500">{{ product.title }}</strong>
        <strong style="font-family:var(--font-display);font-size:1.6rem;font-weight:500">{% render 'price', product: product %}</strong>
      </div>
    </div>
    <div class="btn-row" style="justify-content:center;margin-top:48px">
      <a class="btn btn--block" style="max-width:520px;min-height:64px" href="#buy-box">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Bundle value stack",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The system" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Large CTA label", "default": "Choose your plan", "info": "Scrolls to the buy box. Not an add-to-cart." }
  ],
  "presets": [{ "name": "Bundle value stack" }]
}
{% endschema %}
