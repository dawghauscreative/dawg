{%- comment -%}
  Interactive Venn (client review Nov 7): centred diagram; hovering or tapping a circle, an overlap or the centre slides in that
  product's or pairing's info (assets/theme.js [data-venn]). Product names link to their pages. Pair blocks map to overlaps by
  their "Overlap" setting (or by order: Protect+Balance, Protect+Restore, Balance+Restore, all three).
{%- endcomment -%}
{%- liquid
  assign p_uv = all_products['uv-shield']
  assign p_sk = all_products['skinbiotic']
  assign p_db = all_products['dermaboost']
  assign url_uv = p_uv.url | default: '/products/uv-shield'
  assign url_sk = p_sk.url | default: '/products/skinbiotic'
  assign url_db = p_db.url | default: '/products/dermaboost'
  assign regions = 'ab,ac,bc,abc' | split: ','
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body, center: section.settings.center -%}
    <div class="venn" data-venn data-venn-mode="regions">
      <div class="venn__stage">
        <svg class="venn__svg" viewBox="0 0 600 510" role="group" aria-label="Protect, Balance and Restore: hover or tap to explore" data-venn-svg>
          <g class="venn__circles" stroke="var(--c-gold)" stroke-width="1.5" fill="var(--c-gold)">
            <circle data-venn-circle="a" cx="300" cy="175" r="150"/>
            <circle data-venn-circle="b" cx="213" cy="325" r="150"/>
            <circle data-venn-circle="c" cx="387" cy="325" r="150"/>
          </g>
          <g class="venn__labels" fill="currentColor" text-anchor="middle">
            <a href="{{ url_uv }}" data-venn-focus="a"><text x="300" y="98" class="venn__title">Protect</text><text x="300" y="126" class="venn__sub">UV Shield+</text></a>
            <a href="{{ url_sk }}" data-venn-focus="b"><text x="176" y="392" class="venn__title">Balance</text><text x="176" y="420" class="venn__sub">Skinbiotic+</text></a>
            <a href="{{ url_db }}" data-venn-focus="c"><text x="424" y="392" class="venn__title">Restore</text><text x="424" y="420" class="venn__sub">Dermaboost+</text></a>
            <text x="300" y="300" class="venn__center">One system</text>
          </g>
          <g class="venn__dots">
            <g class="venn__dot" tabindex="0" role="button" aria-label="UV Shield+ and Skinbiotic+" data-venn-focus="ab"><circle cx="232" cy="236" r="11"/><path d="M226 236h12M232 230v12"/></g>
            <g class="venn__dot" tabindex="0" role="button" aria-label="UV Shield+ and Dermaboost+" data-venn-focus="ac"><circle cx="368" cy="236" r="11"/><path d="M362 236h12M368 230v12"/></g>
            <g class="venn__dot" tabindex="0" role="button" aria-label="Skinbiotic+ and Dermaboost+" data-venn-focus="bc"><circle cx="300" cy="372" r="11"/><path d="M294 372h12M300 366v12"/></g>
            <g class="venn__dot" tabindex="0" role="button" aria-label="All three" data-venn-focus="abc"><circle cx="300" cy="266" r="11"/><path d="M294 266h12M300 260v12"/></g>
          </g>
        </svg>
        <p class="venn__hint">Hover or tap the circles to explore</p>
      </div>
      <div class="venn__panels" aria-live="polite">
        <article class="venn__panel" data-venn-panel="a">
          <span class="venn__eyebrow">Protect</span>
          <h3><a href="{{ url_uv }}">UV Shield+</a></h3>
          <div class="prose">{{ section.settings.protect_text }}</div>
          <a class="text-link" href="{{ url_uv }}">View UV Shield+</a>
        </article>
        <article class="venn__panel" data-venn-panel="b">
          <span class="venn__eyebrow">Balance</span>
          <h3><a href="{{ url_sk }}">Skinbiotic+</a></h3>
          <div class="prose">{{ section.settings.balance_text }}</div>
          <a class="text-link" href="{{ url_sk }}">View Skinbiotic+</a>
        </article>
        <article class="venn__panel" data-venn-panel="c">
          <span class="venn__eyebrow">Restore</span>
          <h3><a href="{{ url_db }}">Dermaboost+</a></h3>
          <div class="prose">{{ section.settings.restore_text }}</div>
          <a class="text-link" href="{{ url_db }}">View Dermaboost+</a>
        </article>
        {%- for block in section.blocks -%}
          {%- assign region = block.settings.region | default: regions[forloop.index0] | default: 'abc' -%}
          <article class="venn__panel" data-venn-panel="{{ region }}" {{ block.shopify_attributes }}>
            {%- if block.settings.subtitle != blank -%}<span class="venn__eyebrow">{{ block.settings.subtitle }}</span>{%- endif -%}
            <h3>{{ block.settings.title }}</h3>
            <div class="prose">{{ block.settings.text }}</div>
          </article>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.caption != blank -%}<p class="sci-caption{% if section.settings.center %} sci-caption--center{% endif %}">{{ section.settings.caption }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science system map",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "checkbox", "id": "center", "label": "Centre heading, text and caption", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "textarea", "id": "caption", "label": "Caption" },
    { "type": "header", "content": "Circle info (shown on hover)" },
    { "type": "richtext", "id": "protect_text", "label": "Protect / UV Shield+", "default": "<p>Daily support for active, sun-ready skin.† Designed around nutritional and antioxidant support for people who spend significant time outdoors.†</p>" },
    { "type": "richtext", "id": "balance_text", "label": "Balance / Skinbiotic+", "default": "<p>Daily probiotic for gut and skin health.† A synbiotic approach designed around the connection between the intestinal microbiome and skin wellness.</p>" },
    { "type": "richtext", "id": "restore_text", "label": "Restore / Dermaboost+", "default": "<p>Daily immune support for calm, balanced skin.† A multi-nutrient formula built around antioxidant, immune, and skin-resilience support.†</p>" }
  ],
  "blocks": [
    { "type": "pair", "name": "Pairing", "settings": [{ "type": "select", "id": "region", "label": "Overlap", "default": "", "options": [{ "value": "", "label": "By order" }, { "value": "ab", "label": "Protect + Balance" }, { "value": "ac", "label": "Protect + Restore" }, { "value": "bc", "label": "Balance + Restore" }, { "value": "abc", "label": "All three (centre)" }] }, { "type": "text", "id": "title", "label": "Title" }, { "type": "text", "id": "subtitle", "label": "Subtitle" }, { "type": "richtext", "id": "text", "label": "Text" }] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Science system map" }]
}
{% endschema %}
