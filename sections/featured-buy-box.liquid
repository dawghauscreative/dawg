{%- comment -%}
  Home page "featured product" buy box: the same product form as the product page, on any page.
  PURCHASE RULES (Supr owns the buy box), same as pdp-main:
  - The form posts to /cart/add as a normal HTML form. No quantity input, no selling_plan input, no Buy it now button.
  - Supr's "Subscriptions + Bundles" app block, added to THIS section in the theme editor, renders inside the form and
    supplies the plan choices. The section's product setting is what the app block reads (closest.product).
  - Without the Supr block the button adds a one-time purchase, so keep "Show Add to cart without a plan block" off
    until the Supr block is in place; until then the button links to the product page plan options instead.
{%- endcomment -%}
{%- assign p = section.settings.product -%}
{%- if p != blank -%}
{%- liquid
  assign current_variant = p.selected_or_first_available_variant
  assign form_id = 'featured-buy-form-' | append: section.id
  assign has_app_block = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}
<section class="section scheme-{{ section.settings.color_scheme }} home-buy" {{ section.shopify_attributes }}>
  <div class="container home-buy__grid">
    <div class="home-buy__media">
      {%- if section.settings.asset != blank -%}
        {% render 'responsive-image', asset: section.settings.asset, asset_width: 1200, asset_height: 1500, ratio: '4x5', sizes: '(min-width: 990px) 45vw, 100vw', alt: p.title %}
      {%- else -%}
        {% render 'responsive-image', image: p.featured_media, ratio: '4x5', sizes: '(min-width: 990px) 45vw, 100vw', alt: p.title %}
      {%- endif -%}
    </div>
    <div class="home-buy__info">
      {%- if section.settings.heading != blank -%}<p class="home-buy__kicker">{{ section.settings.heading }}</p>{%- endif -%}
      <h2 class="pdp__title"><a href="{{ p.url }}">{{ p.title }}</a></h2>
      {%- if p.metafields.custom.tagline != blank -%}
        <p class="pdp__tagline">{{ p.metafields.custom.tagline }}{% if settings.fda_disclaimer_text != blank %}<sup>{{ settings.fda_dagger }}</sup>{% endif %}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<div class="prose home-buy__text">{{ section.settings.text }}</div>{%- endif -%}
      {%- if settings.show_base_price -%}<p class="pdp__price">{% render 'price', product: p %}</p>{%- endif -%}

      <div class="buy-box">
        {%- form 'product', p, id: form_id, class: 'buy-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="product-id" value="{{ p.id }}">
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
          {%- endfor -%}
          {%- if has_app_block or section.settings.allow_plain_add -%}
            <button type="submit" name="add" class="btn btn--block" {% unless current_variant.available %}disabled aria-disabled="true"{% endunless %}>
              {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
            </button>
          {%- endif -%}
        {%- endform -%}
        {%- unless has_app_block or section.settings.allow_plain_add -%}
          <a class="btn btn--block" href="{{ p.url }}#buy-box">{{ settings.sticky_cta_label }}</a>
          {%- if request.design_mode -%}<p class="small">[Editor only] Add Supr's "Subscriptions + Bundles" block to this section (Add block &gt; Apps) to show the plan options here.</p>{%- endif -%}
        {%- endunless -%}
        {%- if settings.physician_note != blank -%}<p class="small physician-note">{{ settings.physician_note }}</p>{%- endif -%}
      </div>
      <p class="small home-buy__more"><a class="text-link" href="{{ p.url }}">{{ section.settings.details_label }}</a></p>
      <div class="small">{% render 'fda-disclaimer', dagger: true %}</div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Featured product buy box",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "asset", "label": "Image: theme asset filename", "info": "e.g. product-3d-uv-shield-portrait.webp. Blank = the product's first image." },
    { "type": "text", "id": "heading", "label": "Small label above the product name", "default": "Start here" },
    { "type": "richtext", "id": "text", "label": "Short text" },
    { "type": "text", "id": "details_label", "label": "Product page link label", "default": "See full details" },
    { "type": "checkbox", "id": "allow_plain_add", "label": "Show Add to cart without a plan block", "default": false, "info": "Leave off. Without Supr's block the cart button would add a one-time purchase only." },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "green", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }] }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Featured product buy box" }]
}
{% endschema %}
