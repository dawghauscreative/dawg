{%- assign head_center = false -%}
{%- assign rt_img = false -%}
{%- if section.settings.image != blank or section.settings.image_asset != blank or section.settings.graphic == 'alchemy' -%}{%- assign rt_img = true -%}{%- endif -%}
{%- if section.settings.align == 'center' -%}{%- assign head_center = true -%}{%- endif -%}
{%- if section.settings.heading != blank or section.settings.body != blank -%}
<section class="section scheme-{{ section.settings.color_scheme }}{% if section.settings.salt_symbol %} has-salt{% endif %}{% if section.settings.tight_bottom %} rt-tight-bottom{% endif %}" {{ section.shopify_attributes }}>
  {%- if section.settings.salt_symbol -%}
    <svg class="salt-symbol" viewBox="0 0 400 400" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="10"><circle cx="200" cy="200" r="170"/><path d="M10 200h380"/></svg>
  {%- endif -%}
  <div class="container" style="position:relative;max-width:{% if rt_img %}1240px{% elsif section.settings.width == 'narrow' %}760px{% else %}1100px{% endif %}{% if section.settings.align == 'center' %};text-align:center{% endif %}">
    {%- if rt_img -%}
    <div class="rich-split{% if section.settings.image_side == 'right' %} rich-split--right{% endif %}">
      <div class="rich-split__media">{%- if section.settings.graphic == 'alchemy' -%}{% render 'alchemy-emblem', uid: section.id %}{%- else -%}{%- liquid
          assign rt_ratio = section.settings.image_ratio | default: '4x5'
          assign rt_w = 1200
          assign rt_h = 1500
          if rt_ratio == '3x2'
            assign rt_w = 1500
            assign rt_h = 1000
          endif
        -%}{% render 'responsive-image', image: section.settings.image, asset: section.settings.image_asset, asset_width: rt_w, asset_height: rt_h, ratio: rt_ratio, sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.image_alt %}{%- endif -%}</div>
      <div class="rich-split__copy">
    {%- endif -%}
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, tag: section.settings.heading_tag, center: head_center -%}
    {%- if section.settings.body != blank -%}<div class="prose"{% if section.settings.align == 'center' %} style="margin-inline:auto"{% endif %}>{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.quote != blank -%}<p class="pull-quote"{% if section.settings.align == 'center' %} style="margin-inline:auto"{% endif %}>{{ section.settings.quote }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <div class="btn-row"{% if section.settings.align == 'center' %} style="justify-content:center"{% endif %}><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></div>
    {%- endif -%}
    {%- if rt_img -%}</div></div>{%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="section--tight scheme-dark" {{ section.shopify_attributes }}><div class="container small">[Editor only] Rich text is empty and hidden.</div></section>
{%- endif -%}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "green-light", "label": "Lighter green" }, { "value": "light", "label": "White" }, { "value": "beige", "label": "Beige" }, { "value": "grey", "label": "Grey (brand)" }, { "value": "band", "label": "Band (black to green)" }] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centered" }] },
    { "type": "select", "id": "width", "label": "Width", "default": "narrow", "options": [{ "value": "narrow", "label": "Narrow" }, { "value": "wide", "label": "Wide" }] },
    { "type": "checkbox", "id": "salt_symbol", "label": "Oversized salt symbol behind the text", "default": false },
    { "type": "checkbox", "id": "tight_bottom", "label": "Less space below", "default": false, "info": "Use when the next section continues this one (e.g. Why pair… followed by its cards)." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h2", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }] },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "quote", "label": "Pull quote" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "header", "content": "Image (optional)" },
    { "type": "select", "id": "graphic", "label": "Graphic instead of an image", "default": "none", "options": [{ "value": "none", "label": "None" }, { "value": "alchemy", "label": "Gold alchemy emblem" }] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Or theme asset filename", "info": "Shown beside the text, e.g. lifestyle-hikers-summit-4x5.webp" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "image_side", "label": "Image side", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "4x5", "options": [{ "value": "4x5", "label": "Portrait (4:5)" }, { "value": "3x2", "label": "Landscape (3:2)" }] }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
