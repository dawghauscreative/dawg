{%- comment -%}
  Native Shopify cart. Plain form post (no JS cart). Shows selling plan name, quantity and discounts from cart data.
  No dynamic checkout / accelerated payment buttons. No upsell add-to-cart buttons.
{%- endcomment -%}
{%- liquid
  assign handles = cart.items | map: 'product' | map: 'handle'
  assign has_skinbiotic = false
  assign has_dermaboost = false
  if handles contains 'skin-recovery-system' or handles contains 'complete-skin-defense-system'
    assign has_skinbiotic = true
    assign has_dermaboost = true
  endif
  if handles contains 'skinbiotic' or handles contains 'sun-safe-system'
    assign has_skinbiotic = true
  endif
  if handles contains 'dermaboost' or handles contains 'sun-resilience-system'
    assign has_dermaboost = true
  endif
-%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    <h1 style="font-size:clamp(2.2rem,4vw,3.4rem);margin-bottom:2.5rem">{{ section.settings.heading }}</h1>

    {%- if cart.item_count == 0 -%}
      <p class="lede">{{ section.settings.empty_text }}</p>
      <div class="btn-row"><a class="btn" href="{{ routes.collections_url }}">{{ section.settings.continue_label }}</a></div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart">
        <div>
          <div class="cart-layout">
            <div>
              {%- for item in cart.items -%}
                <div class="cart-line">
                  <a href="{{ item.url }}">{% render 'responsive-image', image: item.image, ratio: '1x1', sizes: '88px', widths: '176,264', alt: item.product.title %}</a>
                  <div class="cart-line__meta">
                    <div class="cart-line__row">
                      <a href="{{ item.url }}" style="font-family:var(--font-display);font-size:1.4rem;text-decoration:none">{{ item.product.title }}</a>
                      <span>
                        {%- if item.original_line_price != item.final_line_price -%}<s class="was-price">{{ item.original_line_price | money }}</s>{%- endif -%}
                        {{ item.final_line_price | money }}
                      </span>
                    </div>
                    {%- unless item.product.has_only_default_variant -%}<span class="small">{{ item.variant.title }}</span>{%- endunless -%}
                    {%- if item.selling_plan_allocation -%}
                      <span class="cart-line__plan">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                    {%- else -%}
                      <span class="cart-line__plan">{{ section.settings.one_time_label }}</span>
                    {%- endif -%}
                    {%- for property in item.properties -%}
                      {%- assign first_char = property.first | slice: 0 -%}
                      {%- unless property.last == blank or first_char == '_' -%}<span class="small">{{ property.first }}: {{ property.last }}</span>{%- endunless -%}
                    {%- endfor -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <span class="discount-tag">{{ discount.discount_application.title }} (&minus;{{ discount.amount | money }})</span>
                    {%- endfor -%}
                    <div class="cart-line__row" style="margin-top:8px">
                      <div class="field" style="grid-auto-flow:column;align-items:center;gap:12px;justify-content:start">
                        <label for="Qty-{{ item.index | plus: 1 }}" class="visually-hidden">Quantity</label>
                        <input id="Qty-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:84px;min-height:44px">
                      </div>
                      <a class="text-link" href="{{ item.url_to_remove }}">Remove</a>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
              <div style="border-top:1px solid var(--rule)"></div>
              {%- if has_skinbiotic and has_dermaboost -%}
                {%- render 'compliance-slot', content: settings.compliance_pairing_notice -%}
              {%- endif -%}
            </div>

            <aside class="cart-summary">
              {%- for discount in cart.cart_level_discount_applications -%}
                <div class="cart-summary__row discount-tag"><span>{{ discount.title }}</span><span>&minus;{{ discount.total_allocated_amount | money }}</span></div>
              {%- endfor -%}
              <div class="cart-summary__row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
              <p class="small">{{ section.settings.shipping_note }}</p>
              {%- render 'guarantee-badge', style: 'cart' -%}
              <button type="submit" name="update" class="btn btn--outline btn--block">{{ section.settings.update_label }}</button>
              <button type="submit" name="checkout" class="btn btn--block">{{ section.settings.checkout_label }}</button>
            </aside>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "dark", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cart" },
    { "type": "text", "id": "empty_text", "label": "Empty cart text", "default": "Your cart is empty." },
    { "type": "text", "id": "continue_label", "label": "Continue button", "default": "Shop the System" },
    { "type": "text", "id": "one_time_label", "label": "One-time purchase label", "default": "One-time purchase" },
    { "type": "text", "id": "shipping_note", "label": "Note under subtotal", "default": "Shipping and taxes are calculated at checkout." },
    { "type": "text", "id": "update_label", "label": "Update button", "default": "Update cart" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" }
  ]
}
{% endschema %}
