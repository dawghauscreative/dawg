{% comment %} ============================================================
  SECTION: Science Page — sections/science-page.liquid
  Four independently editable blocks:
    1. Hero        (dark background, split layout)
    2. Science     (cream background, 3-column cards via blocks)
    3. Purpose     (dark background, split layout + 2-column cards via blocks)
    4. CTA         (cream background, centered statement)
============================================================ {% endcomment %}

{%- liquid
  assign hero_image = section.settings.hero_image
-%}

{% comment %} ─── 1. HERO ─────────────────────────────────────────────── {% endcomment %}
<section class="page-hero section section--dark">
  <div class="container split">

    <div class="hero__content">
      {%- if section.settings.hero_eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.hero_eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.hero_heading != blank -%}
        <h1>{{ section.settings.hero_heading }}</h1>
      {%- endif -%}

      {%- if section.settings.hero_text != blank -%}
        <p>{{ section.settings.hero_text }}</p>
      {%- endif -%}

      {%- if section.settings.hero_button_label != blank -%}
        <a class="button button--gold" href="{{ section.settings.hero_button_url }}">
          {{ section.settings.hero_button_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="media-frame">
      {%- if hero_image != blank -%}
        <img
          src="{{ hero_image | image_url: width: 900 }}"
          alt="{{ hero_image.alt | escape }}"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
          loading="eager">
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

  </div>
</section>

{% comment %} ─── 2. SCIENCE CARDS (blocks) ───────────────────────────── {% endcomment %}
<section class="section section--cream">
  <div class="container">

    <div class="section-header">
      {%- if section.settings.science_eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.science_eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.science_heading != blank -%}
        <h2>{{ section.settings.science_heading }}</h2>
      {%- endif -%}
    </div>

    <div class="grid grid--3">
      {%- for block in section.blocks -%}
        {%- if block.type == 'science_card' -%}
          <article class="system-card" {{ block.shopify_attributes }}>

            <div class="system-card__image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy">
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="system-card__body">
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>

          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% comment %} ─── 3. PURPOSE (split + purpose_card blocks) ────────────── {% endcomment %}
<section class="section section--dark">
  <div class="container split">

    <div class="purpose__content">
      {%- if section.settings.purpose_eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.purpose_eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.purpose_heading != blank -%}
        <h2>{{ section.settings.purpose_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.purpose_text != blank -%}
        <p>{{ section.settings.purpose_text }}</p>
      {%- endif -%}
    </div>

    <div class="grid grid--2">
      {%- for block in section.blocks -%}
        {%- if block.type == 'purpose_card' -%}
          <article class="card" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% comment %} ─── 4. CTA ──────────────────────────────────────────────── {% endcomment %}
<section class="section section--cream">
  <div class="container statement">

    {%- if section.settings.cta_eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.cta_eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.cta_heading != blank -%}
      <h2>{{ section.settings.cta_heading }}</h2>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <p>{{ section.settings.cta_text }}</p>
    {%- endif -%}

    {%- if section.settings.cta_button_label != blank -%}
      <a class="button button--dark" href="{{ section.settings.cta_button_url }}">
        {{ section.settings.cta_button_label }}
      </a>
    {%- endif -%}

  </div>
</section>

