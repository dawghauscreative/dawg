{%- comment -%} "Not sure where to start?": simple statements that each point to one formula page. {%- endcomment -%}
<section class="section scheme-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="container">
    {%- render 'section-head', eyebrow: section.settings.eyebrow, heading: section.settings.heading, body: section.settings.body -%}
    <div class="cols cols--{{ section.settings.columns }} start-paths">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <a class="start-path" href="{{ p.url | default: routes.collections_url }}" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.statement }}</h3>
          <span class="start-path__go">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.line != blank -%}
      <div class="start-paths__more">
        <p>{{ section.settings.line }}</p>
        {%- if section.settings.button_label != blank -%}<a class="btn btn--outline" href="{{ section.settings.button_url | default: routes.collections_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Start paths",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "default": "light", "options": [{ "value": "dark", "label": "Black" }, { "value": "green", "label": "Evergreen" }, { "value": "light", "label": "Beige" }] },
    { "type": "select", "id": "columns", "label": "Cards per row", "default": "3", "options": [{ "value": "3", "label": "3" }, { "value": "2", "label": "2 (four cards)" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "line", "label": "Closing line" },
    { "type": "text", "id": "button_label", "label": "Closing button label" },
    { "type": "url", "id": "button_url", "label": "Closing button link" }
  ],
  "blocks": [
    { "type": "path", "name": "Path", "settings": [{ "type": "text", "id": "statement", "label": "Statement" }, { "type": "product", "id": "product", "label": "Product" }, { "type": "text", "id": "label", "label": "Label (e.g. Start with UV Shield+)" }] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Start paths" }]
}
{% endschema %}
