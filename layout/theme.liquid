<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js" data-motion="{{ settings.scroll_animations | default: 'full' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_black }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.adobe_kit_url != blank -%}
      <link rel="preconnect" href="https://use.typekit.net" crossorigin>
      <link rel="stylesheet" href="{{ settings.adobe_kit_url }}">
    {%- endif -%}
    {%- if settings.body_font_stylesheet_url != blank -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="{{ settings.body_font_stylesheet_url }}">
    {%- endif -%}
    {%- if settings.display_font_stylesheet_url != blank -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="{{ settings.display_font_stylesheet_url }}">
    {%- endif -%}
    {%- if settings.callout_font_stylesheet_url != blank -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link rel="stylesheet" href="{{ settings.callout_font_stylesheet_url }}">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    {%- capture seo_title -%}
      {%- if request.page_type == 'index' -%}
        {{- page_title -}}
      {%- else -%}
        {{- page_title -}}
        {%- if current_page != 1 %} &ndash; Page {{ current_page }}{%- endif -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{%- endunless -%}
      {%- endif -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>
    {%- if page_description != blank -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <style>
      :root {
        --c-black: {{ settings.color_black }};
        --c-charcoal: {{ settings.color_charcoal }};
        --c-emerald: {{ settings.color_evergreen }};
        --c-evergreen: {{ settings.color_evergreen }};
        --c-gold: {{ settings.color_gold }};
        --c-beige: {{ settings.color_beige }};
        --c-gray: {{ settings.color_gray }};
        --c-white: {{ settings.color_white }};
        --font-display: {{ settings.display_font_family }};
        --font-body: {{ settings.body_font_family }};
        --font-callout: {{ settings.callout_font_family }};
        --headline-weight: {{ settings.headline_weight }};
      }
    </style>
    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handleize }}{% if current_tags.size > 0 %} is-filtered{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {%- sections 'header-group' -%}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    {%- comment -%} Floating "Choose your plan" on every page (bottom bar on phones, pill on desktop): a plain link to Shop All, never an add-to-cart. On Shop All it jumps to the bundles grid. Product pages have their own bar in pdp-main; the cart already has checkout. {%- endcomment -%}
    {%- liquid
      assign show_plan_cta = true
      if template.name == 'product' or template.name == 'cart' or template.name == 'password' or template.name == 'gift_card'
        assign show_plan_cta = false
      endif
      assign plan_cta_url = routes.collections_url | append: '/shop-all'
      if template.name == 'collection' and collection.handle == 'shop-all'
        assign plan_cta_url = '#shop-grid'
      endif
    -%}
    {%- if show_plan_cta -%}
      <div class="sticky-cta plan-cta" data-plan-cta aria-hidden="true" inert>
        <span class="sticky-cta__title">Alchemia MD</span>
        <a class="btn" href="{{ plan_cta_url }}">{{ settings.sticky_cta_label }}</a>
      </div>
    {%- endif -%}

    <button class="back-to-top" type="button" data-back-to-top aria-label="Back to top" hidden>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
    </button>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
