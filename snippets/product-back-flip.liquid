{%- comment -%}
  Supplement Facts panel that a product card's photo turns over to on hover (Nov 14). Bundles show the panel of
  their first product. Render it right after the card's front
  image, inside the same media container. Not shown on product pages. CSS: "Product card photos flip" in theme.css.
  Usage: {% render 'product-back-flip', handle: product.handle %}
{%- endcomment -%}
{%- unless template.name == 'product' -%}
  {%- liquid
    case handle
      when 'uv-shield', 'outdoor-duo', 'sun-safe-system', 'sun-resilience-duo', 'sun-resilience-system', 'tria-prima', 'complete-skin-defense-system'
        assign back = 'product-angle-uv-shield-facts.webp'
      when 'skinbiotic', 'balance-duo', 'skin-recovery-system'
        assign back = 'product-angle-skinbiotic-facts.webp'
      when 'dermaboost'
        assign back = 'product-angle-dermaboost-facts.webp'
      else
        assign back = ''
    endcase
  -%}
  {%- if back != blank -%}
    <span class="backflip" aria-hidden="true"><img src="{{ back | asset_url }}" alt="" width="1200" height="1500" loading="lazy"></span>
  {%- endif -%}
{%- endunless -%}
