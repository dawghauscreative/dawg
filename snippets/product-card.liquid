{%- comment -%}
  Cards link to the product page. NO add-to-cart button, no quick add (it would add a one-time single at full price).
  Usage: {% render 'product-card', product: p, role: 'Protect' %} (role is optional)
{%- endcomment -%}
{%- if product != blank -%}
  <a class="pcard" href="{{ product.url }}">
    <div class="pcard__media">
      {%- capture fallback_capture -%}{%- render 'product-fallback-asset', handle: product.handle -%}{%- endcapture -%}
      {%- assign fallback_asset = fallback_capture | strip -%}
      {%- render 'responsive-image', image: product.featured_media, asset: fallback_asset, ratio: '4x5', sizes: '(min-width: 750px) 33vw, 100vw', alt: product.title -%}
    </div>
    <div class="pcard__body">
      {%- if role != blank -%}<span class="role-badge">{{ role }}</span>{%- endif -%}
      <h3 class="pcard__title">{{ product.title }}</h3>
      {%- assign card_line = product.metafields.custom.summary | default: product.metafields.custom.tagline -%}
      {%- if card_line != blank -%}
        <p class="pcard__tagline">{{ card_line }}{% if settings.fda_disclaimer_text != blank %}<sup>{{ settings.fda_dagger }}</sup>{% endif %}</p>
      {%- endif -%}
      <p class="pcard__price">{% render 'price', product: product %}</p>
      <span class="text-link pcard__link">View product</span>
    </div>
  </a>
{%- endif -%}
