{%- comment -%}
  Cards link to the product page. NO add-to-cart button, no quick add (it would add a one-time single at full price).
  Usage: {% render 'product-card', product: p %}
{%- endcomment -%}
{%- if product != blank -%}
  <a class="pcard" href="{{ product.url }}">
    <div class="pcard__media">
      {%- render 'responsive-image', image: product.featured_media, ratio: '4x5', sizes: '(min-width: 750px) 33vw, 100vw', alt: product.title -%}
    </div>
    <div class="pcard__body">
      <h3 class="pcard__title">{{ product.title }}</h3>
      {%- if product.metafields.custom.tagline != blank -%}
        <p class="pcard__tagline">{{ product.metafields.custom.tagline }}{% if settings.fda_disclaimer_text != blank %}<sup>{{ settings.fda_dagger }}</sup>{% endif %}</p>
      {%- endif -%}
      <p class="pcard__price">{% render 'price', product: product %}</p>
      <span class="text-link pcard__link">View product</span>
    </div>
  </a>
{%- endif -%}
