{%- comment -%}
  "How to take it" card under the product gallery. Label directions come word for word from each product's
  custom.directions (a bundle reads its components, so the copy lives in one place). Enhanced Support blocks show only
  for the product handles listed in enhanced_products, and the supply line only when one of them is shown and the
  page's custom.supply_line metafield has text. Everything is empty and hidden when there is nothing to show.
  An optional explainer (enhanced_heading + enhanced_text) shows under the directions only when Enhanced Support blocks show.
  Config comes from product metafields: custom.enhanced_products (handles, comma separated; empty = label text only) and
  custom.enhanced_explainer (rich text), plus custom.supply_line. Usage: {% render 'how-to-take', product: product %}
{%- endcomment -%}
{%- assign components = product.metafields.custom.bundle_components.value -%}
{%- assign heading = 'How to take it' -%}
{%- assign enhanced_heading = 'What is Enhanced Support?' -%}
{%- assign enhanced_list = product.metafields.custom.enhanced_products.value | replace: ' ', '' | downcase | split: ',' -%}
{%- assign has_text = false -%}
{%- assign shows_enhanced = false -%}
{%- if components != blank -%}
  {%- for c in components -%}
    {%- capture t -%}{%- render 'product-directions', p: c -%}{%- endcapture -%}
    {%- if t != blank -%}{%- assign has_text = true -%}{%- endif -%}
    {%- if enhanced_list contains c.handle and t contains 'For enhanced support, ' -%}{%- assign shows_enhanced = true -%}{%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- capture t -%}{%- render 'product-directions', p: product -%}{%- endcapture -%}
  {%- if t != blank -%}{%- assign has_text = true -%}{%- endif -%}
  {%- if enhanced_list contains product.handle and t contains 'For enhanced support, ' -%}{%- assign shows_enhanced = true -%}{%- endif -%}
{%- endif -%}
{%- if has_text -%}
<aside class="how-to-take">
  {%- if heading != blank -%}<h2>{{ heading }}</h2>{%- endif -%}
  {%- if components != blank -%}
    {%- for c in components -%}
      {%- assign item_enhanced = false -%}
      {%- if enhanced_list contains c.handle -%}{%- assign item_enhanced = true -%}{%- endif -%}
      {%- render 'how-to-take-item', p: c, show_title: true, show_enhanced: item_enhanced -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign item_enhanced = false -%}
    {%- if enhanced_list contains product.handle -%}{%- assign item_enhanced = true -%}{%- endif -%}
    {%- render 'how-to-take-item', p: product, show_title: false, show_enhanced: item_enhanced -%}
  {%- endif -%}
  {%- if shows_enhanced and product.metafields.custom.enhanced_explainer != blank -%}
    <div class="how-to-take__explainer">
      <h3>{{ enhanced_heading }}</h3>
      <div class="prose">{{ product.metafields.custom.enhanced_explainer | metafield_tag }}</div>
    </div>
  {%- endif -%}
  {%- if shows_enhanced and product.metafields.custom.supply_line != blank -%}
    <p class="how-to-take__supply">{{ product.metafields.custom.supply_line.value | escape }}</p>
  {%- endif -%}
  <p class="how-to-take__caution small">Consult your healthcare professional before taking if you are pregnant, nursing, taking any medications or have a medical condition.</p>
</aside>
{%- endif -%}
