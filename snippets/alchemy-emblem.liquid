{%- comment -%}
  Gold alchemy emblem (Nov 12, simplified): three alchemical salt symbols (a circle with a line through it) side by side,
  in a gold gradient. Each one gently pulses in turn. Usage: {% render 'alchemy-emblem', uid: section.id %}
{%- endcomment -%}
{%- assign g = 'alchGold-' | append: uid -%}
<svg class="alch-emblem alch-emblem--salts" viewBox="0 0 420 160" role="img" aria-label="Three gold alchemical salt symbols side by side">
  <defs>
    <linearGradient id="{{ g }}" gradientUnits="userSpaceOnUse" x1="0" y1="20" x2="420" y2="140">
      <stop offset="0" stop-color="#8a6a2e"/>
      <stop offset=".3" stop-color="#E3B04B"/>
      <stop offset=".5" stop-color="#f6dc9a"/>
      <stop offset=".72" stop-color="#C9A96E"/>
      <stop offset="1" stop-color="#8a6a2e"/>
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#{{ g }})" stroke-width="5" stroke-linecap="round">
    <g class="alch-emblem__salt" style="--d: 0s; transform-origin: 72px 80px"><circle cx="72" cy="80" r="56"/><path d="M8 80h128"/></g>
    <g class="alch-emblem__salt" style="--d: 1s; transform-origin: 210px 80px"><circle cx="210" cy="80" r="56"/><path d="M146 80h128"/></g>
    <g class="alch-emblem__salt" style="--d: 2s; transform-origin: 348px 80px"><circle cx="348" cy="80" r="56"/><path d="M284 80h128"/></g>
  </g>
</svg>
