{%- comment -%}
  Gold alchemy emblem (Nov 12): the alchemical symbols for Air, Water and Earth side by side in a gold gradient, with a
  light glint sweeping across them (SVG animation, paused for reduced motion or when animations are off).
  Usage: {% render 'alchemy-emblem', uid: section.id %}
{%- endcomment -%}
{%- assign g = 'alchGold-' | append: uid -%}
{%- assign s = 'alchShine-' | append: uid -%}
<svg class="alch-emblem alch-emblem--salts" viewBox="0 0 420 160" role="img" aria-label="Gold alchemical symbols for air, water and earth">
  <defs>
    <linearGradient id="{{ g }}" gradientUnits="userSpaceOnUse" x1="0" y1="20" x2="420" y2="140">
      <stop offset="0" stop-color="#8a6a2e"/>
      <stop offset=".3" stop-color="#E3B04B"/>
      <stop offset=".5" stop-color="#f6dc9a"/>
      <stop offset=".72" stop-color="#C9A96E"/>
      <stop offset="1" stop-color="#8a6a2e"/>
    </linearGradient>
    <linearGradient id="{{ s }}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="420" y2="60">
      <stop offset="0" stop-color="#fff8e6" stop-opacity="0"/>
      <stop offset=".4" stop-color="#fff8e6" stop-opacity="0"/>
      <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
      <stop offset=".6" stop-color="#fff8e6" stop-opacity="0"/>
      <stop offset="1" stop-color="#fff8e6" stop-opacity="0"/>
      <animateTransform attributeName="gradientTransform" type="translate" values="-460 0; 460 0; 460 0" keyTimes="0; .6; 1" dur="4.5s" repeatCount="indefinite"/>
    </linearGradient>
    <g id="{{ uid }}-shapes">
      <path d="M72 30L130 130H14Z"/><path d="M22 96.7h100"/>
      <path d="M210 130L152 30H268Z"/>
      <path d="M348 130L290 30H406Z"/><path d="M298 63.3h100"/>
    </g>
  </defs>
  <g fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
    <use href="#{{ uid }}-shapes" stroke="url(#{{ g }})"/>
    <use href="#{{ uid }}-shapes" stroke="url(#{{ s }})" stroke-width="5.5"/>
  </g>
</svg>
<script>
  (function () {
    var svg = document.currentScript && document.currentScript.previousElementSibling;
    if (!svg || !svg.pauseAnimations) return;
    var still = (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) || document.documentElement.getAttribute('data-motion') === 'off';
    if (still) svg.pauseAnimations();
  })();
</script>
