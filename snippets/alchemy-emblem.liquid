{%- comment -%}
  Gold alchemy emblem (Nov 12): the classic "squared circle" figure (circle, square, triangle, inner circle) with the
  alchemical symbol for salt at its heart, inside a slowly turning ring of ticks. Pure SVG, gold gradient stroke.
  Usage: {% render 'alchemy-emblem', uid: section.id %}
{%- endcomment -%}
{%- assign g = 'alchGold-' | append: uid -%}
<svg class="alch-emblem" viewBox="0 0 400 400" role="img" aria-label="Gold alchemy emblem: circle, square and triangle around the alchemical symbol for salt">
  <defs>
    <linearGradient id="{{ g }}" gradientUnits="userSpaceOnUse" x1="40" y1="40" x2="360" y2="360">
      <stop offset="0" stop-color="#8a6a2e"/>
      <stop offset=".35" stop-color="#E3B04B"/>
      <stop offset=".55" stop-color="#f6dc9a"/>
      <stop offset=".8" stop-color="#C9A96E"/>
      <stop offset="1" stop-color="#8a6a2e"/>
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#{{ g }})" stroke-linecap="round" stroke-linejoin="round">
    <g class="alch-emblem__ring">
      <circle cx="200" cy="200" r="186" stroke-width="1.5"/>
      <circle cx="200" cy="200" r="176" stroke-width="8" stroke-dasharray="1.2 8" opacity=".75"/>
    </g>
    <circle cx="200" cy="200" r="158" stroke-width="2"/>
    <rect x="88.3" y="88.3" width="223.4" height="223.4" stroke-width="2"/>
    <path d="M200 88.3 L311.7 311.7 L88.3 311.7 Z" stroke-width="2"/>
    <circle cx="200" cy="242.7" r="69" stroke-width="1.5" opacity=".7"/>
    <g class="alch-emblem__salt">
      <circle cx="200" cy="242.7" r="34" stroke-width="4.5"/>
      <path d="M158 242.7h84" stroke-width="4.5"/>
    </g>
  </g>
  <g fill="url(#{{ g }})">
    <circle cx="88.3" cy="88.3" r="4.5"/><circle cx="311.7" cy="88.3" r="4.5"/>
    <circle cx="88.3" cy="311.7" r="4.5"/><circle cx="311.7" cy="311.7" r="4.5"/>
    <circle cx="200" cy="88.3" r="5.5"/>
  </g>
</svg>
