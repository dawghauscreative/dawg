# LeadConnector (GoHighLevel) Private Integration Tokens, one per brand/location.
# Copy this file to .env (which is gitignored) and fill in real values locally —
# never commit actual tokens.

# DHC
GHL_DHC_PRIVATE_TOKEN=
GHL_DHC_LOCATION_ID=
GHL_DHC_TIMEZONE=America/New_York

# HSCF
GHL_HSCF_PRIVATE_TOKEN=
GHL_HSCF_LOCATION_ID=

# TELA
GHL_TELA_PRIVATE_TOKEN=
GHL_TELA_LOCATION_ID=
GHL_TELA_TIMEZONE=America/New_York

# CSG
GHL_CSG_PRIVATE_TOKEN=
GHL_CSG_LOCATION_ID=
GHL_CSG_TIMEZONE=America/New_York

# IL
GHL_IL_PRIVATE_TOKEN=
GHL_IL_LOCATION_ID=
GHL_IL_TIMEZONE=America/New_York
